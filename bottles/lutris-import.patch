+# This program is free software: you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation, in version 3 of the License.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+#
+"""
+Turn a Lutris installer script into a Bottles installer manifest.
+
+Conversion is pure: it validates the script and builds a manifest whose
+steps are carried out by bottles.backend.managers.lutris at install time.
+Only the parts of the format that make sense inside a single Wine bottle
+are accepted; anything else is reported up front, before the user commits
+to an install.
+"""
+
+import os
+import re
+from dataclasses import dataclass, field
+from typing import Any
+
+from bottles.backend.utils import yaml
+
+# Placeholder the manifest uses for the bottle path until install time.
+PREFIX_VAR = "BOTTLE_PREFIX"
+
+# Runner names Lutris uses for Windows games.
+WINE_RUNNERS = {"wine", "winesteam", None}
+
+# Plain commands, i.e. the keys of an entry in the "installer" list.
+SUPPORTED_COMMANDS = {
+    "chmodx",
+    "copy",
+    "execute",
+    "extract",
+    "input_menu",
+    "merge",
+    "move",
+    "rename",
+    "task",
+    "write_config",
+    "write_file",
+    "write_json",
+}
+
+# Wine tasks, i.e. the "name" of a "task" command.
+SUPPORTED_TASKS = {
+    "create_prefix",
+    "delete_registry_key",
+    "set_regedit",
+    "wineexec",
+    "winekill",
+    "winetricks",
+}
+
+# Tasks that only matter interactively; skipped with a warning.
+SKIPPED_TASKS = {"winecfg", "joycpl"}
+
+# Winetricks verbs whose Bottles dependency has a different name.
+# Verbs that are not listed here are tried under their own name first.
+WINETRICKS_ALIASES: dict[str, list[str]] = {
+    "vcrun6": ["vcredist6"],
+    "vcrun6sp6": ["vcredist6sp6"],
+    "vcrun2005": ["vcredist2005"],
+    "vcrun2008": ["vcredist2008"],
+    "vcrun2010": ["vcredist2010"],
+    "vcrun2012": ["vcredist2012"],
+    "vcrun2013": ["vcredist2013"],
+    "vcrun2015": ["vcredist2015"],
+    "vcrun2017": ["vcredist2019"],
+    "vcrun2019": ["vcredist2019"],
+    "vcrun2022": ["vcredist2022"],
+    "corefonts": [
+        "andale32",
+        "arial32",
+        "arialb32",
+        "comic32",
+        "courie32",
+        "georgi32",
+        "impact32",
+        "times32",
+        "trebuc32",
+        "verdan32",
+        "webdin32",
+    ],
+    "tahoma": ["tahoma32"],
+    "cjkfonts": ["cjkfonts"],
+    "allfonts": ["allfonts"],
+    "xact_x64": ["xact_x64"],
+    "dotnet40_kb2468871": ["dotnet40"],
+}
+
+# Lutris spells DLL override modes out; Bottles uses wine's short form.
+OVERRIDE_MODES = {
+    "builtin": "b",
+    "native": "n",
+    "builtin,native": "b,n",
+    "native,builtin": "n,b",
+    "disabled": "d",
+    "": "d",
+}
+
+_VAR_RE = re.compile(r"\$(?:\{(\w+)\}|(\w+))")
+
+
+class LutrisScriptError(Exception):
+    """The script cannot be imported; the message lists every problem."""
+
+
+@dataclass
+class LutrisFile:
+    id: str
+    url: str | None = None  # None when the user has to pick the file
+    filename: str = ""
+    checksum: str | None = None
+    label: str = ""  # Shown next to the file picker for local files
+
+
+@dataclass
+class ConvertedScript:
+    key: str
+    entry: dict
+    manifest: dict
+    warnings: list[str] = field(default_factory=list)
+
+
+def expand(value: Any, variables: dict[str, str]) -> Any:
+    """
+    Replace $VAR and ${VAR} the way Lutris does. Unknown names are left
+    alone, so shell variables inside "execute" commands survive.
+    """
+    if isinstance(value, str):
+
+        def sub(match):
+            name = match.group(1) or match.group(2)
+            return variables.get(name, match.group(0))
+
+        return _VAR_RE.sub(sub, value)
+    if isinstance(value, list):
+        return [expand(v, variables) for v in value]
+    if isinstance(value, dict):
+        return {k: expand(v, variables) for k, v in value.items()}
+    return value
+
+
+def load(text: str) -> dict:
+    """
+    Accept a script in any of the shapes Lutris hands out: the full
+    installer (name, runner, script), the bare script, a lutris.net API
+    response, or an installer whose script is an embedded YAML string.
+    """
+    try:
+        data = yaml.load(text)
+    except yaml.YAMLError as e:
+        raise LutrisScriptError(f"Not valid YAML: {e}") from e
+
+    if not isinstance(data, dict):
+        raise LutrisScriptError("The file does not contain a Lutris installer.")
+
+    if isinstance(data.get("results"), list):
+        if not data["results"]:
+            raise LutrisScriptError("The API response lists no installer.")
+        data = data["results"][0]
+
+    if isinstance(data.get("content"), str) and "script" not in data:
+        try:
+            content = yaml.load(data["content"])
+        except yaml.YAMLError as e:
+            raise LutrisScriptError(f"Embedded script is not valid YAML: {e}") from e
+        data = {**data, "script": content}
+
+    if "script" not in data:
+        data = {"script": data}
+
+    if not isinstance(data["script"], dict):
+        raise LutrisScriptError("The installer has no script section.")
+    return data
+
+
+def _parse_files(raw: Any, errors: list[str]) -> list[LutrisFile]:
+    files = []
+    for item in raw or []:
+        if not isinstance(item, dict) or len(item) != 1:
+            errors.append(f"Malformed entry in files: {item!r}")
+            continue
+        file_id, spec = next(iter(item.items()))
+        file_id = str(file_id)
+
+        checksum = None
+        filename = ""
+        if isinstance(spec, dict):
+            url = str(spec.get("url", ""))
+            filename = str(spec.get("filename", ""))
+            checksum = spec.get("checksum")
+        else:
+            url = str(spec)
+
+        if url.startswith("N/A"):
+            label = url[4:].strip() if url.startswith("N/A:") else ""
+            files.append(LutrisFile(file_id, None, filename, checksum, label or file_id))
+            continue
+
+        if url.startswith("$STEAM") or url.startswith("$WINESTEAM"):
+            errors.append(f"File '{file_id}' comes from Steam, which is not supported.")
+            continue
+
+        if not re.match(r"^(https?|ftp)://", url):
+            errors.append(f"File '{file_id}' has an unsupported source: {url}")
+            continue
+
+        if not filename:
+            filename = os.path.basename(url.split("?", 1)[0]) or file_id
+        files.append(LutrisFile(file_id, url, filename, checksum))
+
+    # The file picker is keyed by label, so labels must be unique.
+    seen: dict[str, int] = {}
+    for f in files:
+        if f.url is None:
+            seen[f.label] = seen.get(f.label, 0) + 1
+    for f in files:
+        if f.url is None and seen[f.label] > 1:
+            f.label = f"{f.id}: {f.label}"
+    return files
+
+
+def _check_command(command: Any, errors: list[str], warnings: list[str]) -> bool:
+    """Validate one installer command; return whether it should run."""
+    if not isinstance(command, dict) or len(command) != 1:
+        errors.append(f"Malformed installer step: {command!r}")
+        return False
+
+    name, params = next(iter(command.items()))
+    if name not in SUPPORTED_COMMANDS:
+        errors.append(f"Installer step '{name}' is not supported.")
+        return False
+
+    if name == "task":
+        task = (params or {}).get("name")
+        if task in SKIPPED_TASKS:
+            warnings.append(f"Skipping interactive task '{task}'.")
+            return False
+        if task not in SUPPORTED_TASKS:
+            errors.append(f"Wine task '{task}' is not supported.")
+            return False
+
+    if name == "input_menu":
+        params = params or {}
+        options = params.get("options") or []
+        if not options:
+            errors.append("An input_menu step has no options.")
+            return False
+        choice = params.get("preselect")
+        if choice is None:
+            first = options[0]
+            choice = next(iter(first)) if isinstance(first, dict) else first
+        warnings.append(
+            f"Choosing '{choice}' for \"{params.get('description', 'a menu')}\"."
+        )
+    return True
+
+
+def _game_dir(prefix_expr: str, slug: str) -> str:
+    """
+    Where $GAMEDIR points inside the bottle. When the prefix is $GAMEDIR
+    itself, which is by far the common case, the two are the same place;
+    otherwise the game gets a folder of its own under drive_c.
+    """
+    if prefix_expr.strip() in ("$GAMEDIR", "${GAMEDIR}"):
+        return f"${PREFIX_VAR}"
+    return f"${PREFIX_VAR}/drive_c/Games/{slug}"
+
+
+def _executable(game: dict, prefix_expr: str, gamedir: str, name: str, errors):
+    exe = game.get("exe")
+    if not exe:
+        errors.append("The script has no game executable (game.exe).")
+        return None
+
+    exe = str(exe).replace("\\", "/")
+    if prefix_expr:
+        exe = exe.replace(prefix_expr, f"${PREFIX_VAR}")
+    if not exe.startswith("$") and not exe.startswith("/"):
+        # Lutris resolves a relative exe against the game directory.
+        exe = f"{gamedir}/{exe}"
+    exe = expand(exe, {"GAMEDIR": gamedir})
+
+    root = f"${PREFIX_VAR}/drive_c/"
+    if not exe.startswith(root):
+        errors.append(f"The game executable is outside the Wine prefix: {exe}")
+        return None
+
+    path = exe[len(root) :]
+    executable = {
+        "name": name,
+        "file": os.path.basename(path),
+        "path": path,
+    }
+    if game.get("args"):
+        executable["arguments"] = str(game["args"])
+    return executable
+
+
+def convert(data: dict, source: str = "") -> ConvertedScript:
+    """
+    Build a Bottles installer manifest from a loaded Lutris installer.
+    Raises LutrisScriptError listing every problem found.
+    """
+    script = data["script"]
+    errors: list[str] = []
+    warnings: list[str] = []
+
+    runner = data.get("runner")
+    if runner not in WINE_RUNNERS:
+        raise LutrisScriptError(
+            f"This installer uses the '{runner}' runner. Bottles can only "
+            "import installers for Wine."
+        )
+
+    name = str(data.get("name") or script.get("name") or "")
+    if not name:
+        name = os.path.splitext(os.path.basename(source))[0] or "Lutris game"
+    slug = str(
+        data.get("game_slug")
+        or data.get("slug")
+        or re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
+        or "game"
+    )
+
+    game = script.get("game") or {}
+    wine = script.get("wine") or {}
+    system = script.get("system") or {}
+    prefix_expr = str(game.get("prefix") or "$GAMEDIR").rstrip("/")
+    gamedir = _game_dir(prefix_expr, slug)
+
+    files = _parse_files(script.get("files"), errors)
+
+    steps: list[dict] = []
+    if files:
+        steps.append({"action": "lutris", "kind": "files"})
+    for command in script.get("installer") or []:
+        if _check_command(command, errors, warnings):
+            steps.append({"action": "lutris", "kind": "command", "command": command})
+
+    executable = _executable(game, prefix_expr, gamedir, name, errors)
+
+    if wine.get("version"):
+        warnings.append(
+            f"Wine version '{wine['version']}' is ignored; the bottle's runner is used."
+        )
+
+    overrides = {}
+    for dll, mode in (wine.get("overrides") or {}).items():
+        key = str(mode or "").replace(" ", "").lower()
+        if key not in OVERRIDE_MODES:
+            errors.append(f"Unknown DLL override mode for {dll}: {mode}")
+            continue
+        overrides[str(dll)] = OVERRIDE_MODES[key]
+
+    env = {str(k): str(v) for k, v in (system.get("env") or {}).items()}
+    if overrides or env:
+        steps.append({"action": "lutris", "kind": "config"})
+
+    if errors:
+        raise LutrisScriptError("\n".join(errors))
+
+    parameters = {}
+    for key in ("dxvk", "vkd3d"):
+        if key in wine:
+            parameters[key] = bool(wine[key])
+    if "dxvk_nvapi" in wine:
+        parameters["dxvk_nvapi"] = bool(wine["dxvk_nvapi"])
+    if wine.get("fsync"):
+        parameters["sync"] = "fsync"
+    elif wine.get("esync"):
+        parameters["sync"] = "esync"
+
+    arch = game.get("arch") or wine.get("arch") or "win64"
+
+    manifest: dict = {
+        "Name": name,
+        "Description": f"Imported from the Lutris installer {os.path.basename(source)}".strip(),
+        "Arch": arch,
+        "Executable": executable,
+        "Steps": steps,
+        "LocalResources": [f.label for f in files if f.url is None],
+        "Lutris": {
+            "slug": slug,
+            "prefix": prefix_expr,
+            "gamedir": gamedir,
+            "files": [f.__dict__ for f in files],
+            "env": env,
+            "overrides": overrides,
+        },
+    }
+    if parameters:
+        manifest["Parameters"] = parameters
+
+    entry = {
+        "Name": name,
+        "Description": manifest["Description"],
+        "Arch": arch,
+        "Grade": "Bronze",
+    }
+    return ConvertedScript(f"lutris:{slug}", entry, manifest, warnings)
+
+
+def winetricks_dependencies(verb: str, available) -> list[str] | None:
+    """
+    The Bottles dependencies standing in for a winetricks verb, or None
+    when there is no match and winetricks itself has to run it.
+    """
+    candidates = WINETRICKS_ALIASES.get(verb, [verb])
+    if all(c in available for c in candidates):
+        return candidates
+    return None
