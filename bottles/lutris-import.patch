+++ b/bottles/tests/backend/utils/test_lutris.py
@@ -0,0 +1,383 @@
+import pytest
+
+from bottles.backend.utils import lutris
+
+GOG_SCRIPT = """
+name: Example Game
+game_slug: example-game
+version: GOG
+slug: example-game-gog
+runner: wine
+
+script:
+  files:
+    - installer: "N/A:Select the GOG installer"
+    - patch:
+        url: https://example.org/files/patch.zip?x=1
+        checksum: md5:0123
+
+  game:
+    exe: drive_c/GOG Games/Example/example.exe
+    args: -windowed
+    prefix: $GAMEDIR
+
+  installer:
+    - task:
+        name: create_prefix
+        prefix: $GAMEDIR
+    - task:
+        name: winetricks
+        app: vcrun2022 corefonts
+    - task:
+        name: wineexec
+        executable: installer
+        args: /SILENT
+    - extract:
+        file: patch
+        dst: $GAMEDIR/drive_c/GOG Games/Example
+    - task:
+        name: winecfg
+
+  wine:
+    version: lutris-GE-Proton8-26
+    dxvk: true
+    esync: true
+    overrides:
+      d3d9: native,builtin
+
+  system:
+    env:
+      DXVK_ASYNC: 1
+"""
+
+
+def test_convert_gog_script():
+    converted = lutris.convert(lutris.load(GOG_SCRIPT), "example.yaml")
+    manifest = converted.manifest
+
+    assert converted.key == "lutris:example-game"
+    assert manifest["Executable"] == {
+        "name": "Example Game",
+        "file": "example.exe",
+        "path": "GOG Games/Example/example.exe",
+        "arguments": "-windowed",
+    }
+    assert manifest["Parameters"] == {"dxvk": True, "sync": "esync"}
+    assert manifest["LocalResources"] == ["Select the GOG installer"]
+
+    kinds = [s["kind"] for s in manifest["Steps"]]
+    # files come first and config last
+    assert kinds == ["files"] + ["command"] * 5 + ["config"]
+
+    files = {f["id"]: f for f in manifest["Lutris"]["files"]}
+    assert files["installer"]["url"] is None
+    assert files["patch"]["filename"] == "patch.zip"
+    assert manifest["Lutris"]["overrides"] == {"d3d9": "n,b"}
+    assert manifest["Lutris"]["env"] == {"DXVK_ASYNC": "1"}
+    assert manifest["Lutris"]["gamedir"] == "$BOTTLE_PREFIX"
+
+    assert any("lutris-GE-Proton8-26" in w for w in converted.warnings)
+
+
+def test_bare_script_and_separate_prefix():
+    text = """
+files:
+  - setup: https://example.org/setup.exe
+game:
+  exe: $GAMEDIR/game.exe
+  prefix: $GAMEDIR/prefix
+installer:
+  - task:
+      name: wineexec
+      executable: setup
+"""
+    converted = lutris.convert(lutris.load(text), "/tmp/my-game.yaml")
+    manifest = converted.manifest
+
+    assert manifest["Name"] == "my-game"
+    assert manifest["Lutris"]["gamedir"] == "$BOTTLE_PREFIX/drive_c/Games/my-game"
+    assert manifest["Executable"]["path"] == "Games/my-game/game.exe"
+
+
+def test_api_response_with_embedded_content():
+    text = """
+count: 1
+results:
+  - name: From API
+    game_slug: from-api
+    runner: wine
+    content: |
+      game:
+        exe: drive_c/a.exe
+"""
+    converted = lutris.convert(lutris.load(text))
+    assert converted.manifest["Executable"]["path"] == "a.exe"
+
+
+@pytest.mark.parametrize(
+    "text,message",
+    [
+        ("runner: dosbox\nscript: {}", "dosbox"),
+        ("game: {exe: drive_c/a.exe}\ninstaller:\n  - task: {name: dosexec}", "dosexec"),
+        ("installer: []", "game.exe"),
+        ("game: {exe: /usr/bin/true}", "outside the Wine prefix"),
+        ("files:\n  - a: $STEAM:123:x\ngame: {exe: drive_c/a.exe}", "Steam"),
+    ],
+)
+def test_rejected_scripts(text, message):
+    with pytest.raises(lutris.LutrisScriptError, match=message):
+        lutris.convert(lutris.load(text))
+
+
+def test_expand_leaves_unknown_variables():
+    assert lutris.expand("$GAMEDIR/${CACHE}/$PATH", {"GAMEDIR": "/g", "CACHE": "/c"}) == (
+        "/g//c/$PATH"
+    )
+
+
+def test_winetricks_dependencies():
+    available = {"vcredist2022": {}, "d3dx9": {}, "arial32": {}}
+    assert lutris.winetricks_dependencies("vcrun2022", available) == ["vcredist2022"]
+    assert lutris.winetricks_dependencies("d3dx9", available) == ["d3dx9"]
+    # corefonts needs more than what is available
+    assert lutris.winetricks_dependencies("corefonts", available) is None
+    assert lutris.winetricks_dependencies("unknownverb", available) is None
+
+
+def test_duplicate_local_labels_are_made_unique():
+    text = """
+files:
+  - disc1: "N/A:Select the disc"
+  - disc2: "N/A:Select the disc"
+game: {exe: drive_c/a.exe}
+"""
+    manifest = lutris.convert(lutris.load(text)).manifest
+    assert manifest["LocalResources"] == [
+        "disc1: Select the disc",
+        "disc2: Select the disc",
+    ]
+
+
+def test_input_menus_become_dialog_inputs():
+    text = """
+game: {exe: drive_c/a.exe}
+installer:
+  - input_menu:
+      id: lang
+      description: Language
+      options: [{en: English}, {de: Deutsch}]
+      preselect: de
+  - input_menu:
+      options: [low, high]
+"""
+    converted = lutris.convert(lutris.load(text))
+    assert converted.manifest["LutrisInputs"] == [
+        {
+            "key": "lang",
+            "description": "Language",
+            "options": [["en", "English"], ["de", "Deutsch"]],
+            "default": "de",
+        },
+        {
+            "key": "input1",
+            "description": "Choose an option",
+            "options": [["low", "low"], ["high", "high"]],
+            "default": "low",
+        },
+    ]
+    assert [s.get("input") for s in converted.manifest["Steps"]] == ["lang", "input1"]
+    assert converted.warnings == []
+
+
+def test_wine_args_keep_backslashes_and_shell_characters():
+    assert lutris.wine_args(r"/c echo hi > C:\Games\a.exe") == (
+        "/c echo hi '>' 'C:\\Games\\a.exe'"
+    )
+    assert lutris.wine_args(r'/SILENT /DIR="C:\Program Files\Foo"') == (
+        "/SILENT '/DIR=C:\\Program Files\\Foo'"
+    )
+
+
+# --- insert-disc / eject_disc tests ---
+
+
+def test_insert_disc_accepted():
+    """insert-disc with a valid file reference should be accepted."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - insert-disc: {file: disc1}
+"""
+    converted = lutris.convert(lutris.load(text))
+    manifest = converted.manifest
+    steps = [s for s in manifest["Steps"] if s.get("kind") == "command"]
+    assert any("insert-disc" in s["command"] for s in steps)
+
+
+def test_eject_disc_accepted():
+    """eject_disc should be accepted (no parameters)."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - insert-disc: {file: disc1}
+  - eject_disc: {}
+"""
+    converted = lutris.convert(lutris.load(text))
+    manifest = converted.manifest
+    steps = [s for s in manifest["Steps"] if s.get("kind") == "command"]
+    commands = [list(s["command"].keys())[0] for s in steps]
+    assert "insert-disc" in commands
+    assert "eject_disc" in commands
+
+
+def test_insert_disc_unknown_file_id_rejected():
+    """insert-disc referencing an unknown file-id should be rejected."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - insert-disc: {file: nonexistent}
+"""
+    with pytest.raises(lutris.LutrisScriptError, match="insert-disc references unknown file id"):
+        lutris.convert(lutris.load(text))
+
+
+def test_insert_disc_missing_parameter_rejected():
+    """insert-disc without file/src parameter should be rejected."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - insert-disc: {}
+"""
+    with pytest.raises(lutris.LutrisScriptError, match="insert-disc requires a 'file' or 'src' parameter"):
+        lutris.convert(lutris.load(text))
+
+
+def test_insert_disc_with_src_parameter():
+    """insert-disc should accept 'src' as alias for 'file'."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - insert-disc: {src: disc1}
+"""
+    converted = lutris.convert(lutris.load(text))
+    manifest = converted.manifest
+    steps = [s for s in manifest["Steps"] if s.get("kind") == "command"]
+    assert any("insert-disc" in s["command"] for s in steps)
+
+
+def test_eject_disc_ignores_parameters():
+    """eject_disc should accept but warn about extra parameters."""
+    text = """
+files:
+  - disc1: "N/A:Select disc 1"
+game: {exe: drive_c/a.exe}
+installer:
+  - eject_disc: {foo: bar}
+"""
+    converted = lutris.convert(lutris.load(text))
+    manifest = converted.manifest
+    # Should have a warning about ignored parameters
+    assert any("eject_disc does not take parameters" in w for w in converted.warnings)
+    steps = [s for s in manifest["Steps"] if s.get("kind") == "command"]
+    assert any("eject_disc" in s["command"] for s in steps)
+
+def test_describe_steps():
+    text = """
+files:
+  - installer: "N/A:Select the GOG installer"
+  - patch: https://example.org/patch.zip
+game:
+  exe: drive_c/Game/game.exe
+installer:
+  - input_menu:
+      id: LANG
+      options:
+        - de: Deutsch
+        - en: English
+  - task:
+      name: wineexec
+      executable: installer
+  - write_config:
+      file: $GAMEDIR/drive_c/Game/game.ini
+      section: GAME
+      key: language
+      value: $INPUT_LANG
+  - task:
+      name: winecfg
+wine:
+  dxvk: true
+"""
+    manifest = lutris.convert(lutris.load(text), "game.yaml").manifest
+    steps = lutris.describe_steps(manifest)
+    # parameters, files, input_menu, wineexec, write_config, winecfg, register
+    assert len(steps) == 1 + len(manifest["Steps"]) + 1
+    assert [s["title"] for s in steps if not s["hidden"]] == [
+        "Configure bottle",
+        "Download files",
+        "Run installer",
+        "Write config",
+        "Open Wine settings",
+        "Add to library",
+    ]
+    assert steps[3]["subtitle"] == "Select the GOG installer"
+    assert steps[4]["inputs"] == ["LANG"]
+    assert steps[-1]["subtitle"] == "game.exe"
+
+
+def test_describe_execute_commands():
+    text = """
+game:
+  exe: drive_c/game.exe
+installer:
+  - execute:
+      command: WINEDLLOVERRIDES=d3d9=n wine "$GAMEDIR/drive_c/LaunchGame.exe" -silent
+  - execute:
+      command: |
+        cd "$GAMEDIR"
+        ./fix.sh
+      description: Apply the widescreen fix
+  - execute:
+      command: test -f a && rm a
+"""
+    manifest = lutris.convert(lutris.load(text), "game.yaml").manifest
+    steps = [(s["title"], s["subtitle"]) for s in lutris.describe_steps(manifest)]
+    assert steps[:3] == [
+        ("Run program", "LaunchGame.exe"),
+        ("Apply the widescreen fix", ""),
+        ("Run script", ""),
+    ]
+
+
+def test_script_steps():
+    script = """# prepare
+mkdir -p out
+for f in a b; do
+  echo "$f"
+done
+python -c "import time
+f = open('x', 'rb')
+while f.read(4<<20): pass"
+cat <<'END' > out/x.txt
+hello
+END
+cp a \\
+  b
+true
+"""
+    assert lutris.script_steps(script) == [2, 3, 4, 6, 9, 12, 14]
+
+
+def test_script_command():
+    assert lutris.script_command("WINEDEBUG=-all wine /g/LaunchGTAIV.exe -x") == "LaunchGTAIV.exe"
+    assert lutris.script_command("/nix/store/abc/bin/unshield -d out x a.cab") == "unshield"
+    assert lutris.script_command('echo "hi"') is None
