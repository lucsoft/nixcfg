+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with this program.  If not, see <http://www.gnu.org/licenses/>.
+#
+"""
+Turn a Lutris installer script into a Bottles installer manifest.
+
+Conversion is pure: it validates the script and builds a manifest whose
+steps are carried out by bottles.backend.managers.lutris at install time.
+Only the parts of the format that make sense inside a single Wine bottle
+are accepted; anything else is reported up front, before the user commits
+to an install.
+"""
+
+import os
+import re
+import shlex
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+from bottles.backend.utils import yaml
+
+# Placeholder the manifest uses for the bottle path until install time.
+PREFIX_VAR = "BOTTLE_PREFIX"
+
+# Runner names Lutris uses for Windows games.
+WINE_RUNNERS = {"wine", "winesteam", None}
+
+# Plain commands, i.e. the keys of an entry in the "installer" list.
+SUPPORTED_COMMANDS = {
+    "chmodx",
+    "copy",
+    "execute",
+    "extract",
+    "input_menu",
+    "insert-disc",
+    "eject_disc",
+    "merge",
+    "move",
+    "rename",
+    "task",
+    "write_config",
+    "write_file",
+    "write_json",
+}
+
+# Wine tasks, i.e. the "name" of a "task" command.
+SUPPORTED_TASKS = {
+    "create_prefix",
+    "delete_registry_key",
+    "set_regedit",
+    "joycpl",
+    "wineexec",
+    "winecfg",
+    "winekill",
+    "winetricks",
+}
+
+# Winetricks verbs whose Bottles dependency has a different name.
+# Verbs that are not listed here are tried under their own name first.
+WINETRICKS_ALIASES: dict[str, list[str]] = {
+    "vcrun6": ["vcredist6"],
+    "vcrun6sp6": ["vcredist6sp6"],
+    "vcrun2005": ["vcredist2005"],
+    "vcrun2008": ["vcredist2008"],
+    "vcrun2010": ["vcredist2010"],
+    "vcrun2012": ["vcredist2012"],
+    "vcrun2013": ["vcredist2013"],
+    "vcrun2015": ["vcredist2015"],
+    "vcrun2017": ["vcredist2019"],
+    "vcrun2019": ["vcredist2019"],
+    "vcrun2022": ["vcredist2022"],
+    "corefonts": [
+        "andale32",
+        "arial32",
+        "arialb32",
+        "comic32",
+        "courie32",
+        "georgi32",
+        "impact32",
+        "times32",
+        "trebuc32",
+        "verdan32",
+        "webdin32",
+    ],
+    "tahoma": ["tahoma32"],
+    "cjkfonts": ["cjkfonts"],
+    "allfonts": ["allfonts"],
+    "xact_x64": ["xact_x64"],
+    "dotnet40_kb2468871": ["dotnet40"],
+}
+
+# Lutris spells DLL override modes out; Bottles uses wine's short form.
+OVERRIDE_MODES = {
+    "builtin": "b",
+    "native": "n",
+    "builtin,native": "b,n",
+    "native,builtin": "n,b",
+    "disabled": "d",
+    "": "d",
+}
+
+_VAR_RE = re.compile(r"\$(?:\{(\w+)\}|(\w+))")
+
+
+class LutrisScriptError(Exception):
+    """The script cannot be imported; the message lists every problem."""
+
+
+@dataclass
+class LutrisFile:
+    id: str
+    url: str | None = None  # None when the user has to pick the file
+    filename: str = ""
+    checksum: str | None = None
+    label: str = ""  # Shown next to the file picker for local files
+
+
+@dataclass
+class ConvertedScript:
+    key: str
+    entry: dict
+    manifest: dict
+    warnings: list[str] = field(default_factory=list)
+
+
+def expand(value: Any, variables: dict[str, str]) -> Any:
+    """
+    Replace $VAR and ${VAR} the way Lutris does. Unknown names are left
+    alone, so shell variables inside "execute" commands survive.
+    """
+    if isinstance(value, str):
+
+        def sub(match):
+            name = match.group(1) or match.group(2)
+            return variables.get(name, match.group(0))
+
+        return _VAR_RE.sub(sub, value)
+    if isinstance(value, list):
+        return [expand(v, variables) for v in value]
+    if isinstance(value, dict):
+        return {k: expand(v, variables) for k, v in value.items()}
+    return value
+
+
+def load(text: str) -> dict:
+    """
+    Accept a script in any of the shapes Lutris hands out: the full
+    installer (name, runner, script), the bare script, a lutris.net API
+    response, or an installer whose script is an embedded YAML string.
+    """
+    try:
+        data = yaml.load(text)
+    except yaml.YAMLError as e:
+        raise LutrisScriptError(f"Not valid YAML: {e}") from e
+
+    if not isinstance(data, dict):
+        raise LutrisScriptError("The file does not contain a Lutris installer.")
+
+    if isinstance(data.get("results"), list):
+        if not data["results"]:
+            raise LutrisScriptError("The API response lists no installer.")
+        data = data["results"][0]
+
+    if isinstance(data.get("content"), str) and "script" not in data:
+        try:
+            content = yaml.load(data["content"])
+        except yaml.YAMLError as e:
+            raise LutrisScriptError(f"Embedded script is not valid YAML: {e}") from e
+        data = {**data, "script": content}
+
+    if "script" not in data:
+        data = {"script": data}
+
+    if not isinstance(data["script"], dict):
+        raise LutrisScriptError("The installer has no script section.")
+    return data
+
+
+def _parse_files(raw: Any, errors: list[str]) -> list[LutrisFile]:
+    files = []
+    for item in raw or []:
+        if not isinstance(item, dict) or len(item) != 1:
+            errors.append(f"Malformed entry in files: {item!r}")
+            continue
+        file_id, spec = next(iter(item.items()))
+        file_id = str(file_id)
+
+        checksum = None
+        filename = ""
+        if isinstance(spec, dict):
+            url = str(spec.get("url", ""))
+            filename = str(spec.get("filename", ""))
+            checksum = spec.get("checksum")
+        else:
+            url = str(spec)
+
+        if url.startswith("N/A"):
+            label = url[4:].strip() if url.startswith("N/A:") else ""
+            files.append(LutrisFile(file_id, None, filename, checksum, label or file_id))
+            continue
+
+        if url.startswith("$STEAM") or url.startswith("$WINESTEAM"):
+            errors.append(f"File '{file_id}' comes from Steam, which is not supported.")
+            continue
+
+        if not re.match(r"^(https?|ftp)://", url):
+            errors.append(f"File '{file_id}' has an unsupported source: {url}")
+            continue
+
+        if not filename:
+            filename = os.path.basename(url.split("?", 1)[0]) or file_id
+        files.append(LutrisFile(file_id, url, filename, checksum))
+
+    # The file picker is keyed by label, so labels must be unique.
+    seen: dict[str, int] = {}
+    for f in files:
+        if f.url is None:
+            seen[f.label] = seen.get(f.label, 0) + 1
+    for f in files:
+        if f.url is None and seen[f.label] > 1:
+            f.label = f"{f.id}: {f.label}"
+    return files
+
+
+def _check_command(command: Any, errors: list[str], warnings: list[str], known_file_ids: set[str] | None = None) -> bool:
+    """Validate one installer command; return whether it should run."""
+    if not isinstance(command, dict) or len(command) != 1:
+        errors.append(f"Malformed installer step: {command!r}")
+        return False
+
+    name, params = next(iter(command.items()))
+    if name not in SUPPORTED_COMMANDS:
+        errors.append(f"Installer step '{name}' is not supported.")
+        return False
+
+    if name == "task":
+        task = (params or {}).get("name")
+        if task not in SUPPORTED_TASKS:
+            errors.append(f"Wine task '{task}' is not supported.")
+            return False
+
+    if name == "input_menu":
+        if not menu_options((params or {}).get("options")):
+            errors.append("An input_menu step has no options.")
+            return False
+
+    if name == "insert-disc":
+        # insert-disc must reference a known file-id
+        file_id = (params or {}).get("file") or (params or {}).get("src")
+        if not file_id:
+            errors.append("insert-disc requires a 'file' or 'src' parameter referencing a file id.")
+            return False
+        if not isinstance(file_id, str):
+            errors.append("insert-disc 'file'/'src' parameter must be a string (file id).")
+            return False
+        if known_file_ids is not None and file_id not in known_file_ids:
+            errors.append(f"insert-disc references unknown file id: '{file_id}'.")
+            return False
+
+    if name == "eject_disc":
+        # eject_disc takes no parameters
+        if params and len(params) > 0:
+            warnings.append("eject_disc does not take parameters; ignoring them.")
+    return True
+
+
+def menu_options(raw) -> list[list[str]]:
+    """The [value, label] pairs of an input_menu."""
+    options = []
+    for option in raw or []:
+        if isinstance(option, dict) and len(option) == 1:
+            value, label = next(iter(option.items()))
+            options.append([str(value), str(label)])
+        elif isinstance(option, (str, int, float)):
+            options.append([str(option), str(option)])
+    return options
+
+
+def menu_spec(params: dict, key: str) -> dict:
+    """An input_menu as the installer dialog shows it."""
+    options = menu_options(params.get("options"))
+    values = [value for value, _ in options]
+    preselect = str(params.get("preselect", values[0]))
+    return {
+        "key": key,
+        "description": str(params.get("description") or "Choose an option"),
+        "options": options,
+        "default": preselect if preselect in values else values[0],
+    }
+
+
+def _game_dir(prefix_expr: str, slug: str) -> str:
+    """
+    Where $GAMEDIR points inside the bottle. When the prefix is $GAMEDIR
+    itself, which is by far the common case, the two are the same place;
+    otherwise the game gets a folder of its own under drive_c.
+    """
+    if prefix_expr.strip() in ("$GAMEDIR", "${GAMEDIR}"):
+        return f"${PREFIX_VAR}"
+    return f"${PREFIX_VAR}/drive_c/Games/{slug}"
+
+
+def _executable(game: dict, prefix_expr: str, gamedir: str, name: str, errors):
+    exe = game.get("exe")
+    if not exe:
+        errors.append("The script has no game executable (game.exe).")
+        return None
+
+    exe = str(exe).replace("\\", "/")
+    if prefix_expr:
+        exe = exe.replace(prefix_expr, f"${PREFIX_VAR}")
+    if not exe.startswith("$") and not exe.startswith("/"):
+        # Lutris resolves a relative exe against the game directory.
+        exe = f"{gamedir}/{exe}"
+    exe = expand(exe, {"GAMEDIR": gamedir})
+
+    root = f"${PREFIX_VAR}/drive_c/"
+    if not exe.startswith(root):
+        errors.append(f"The game executable is outside the Wine prefix: {exe}")
+        return None
+
+    path = exe[len(root) :]
+    executable = {
+        "name": name,
+        "file": os.path.basename(path),
+        "path": path,
+    }
+    if game.get("args"):
+        executable["arguments"] = str(game["args"])
+    return executable
+
+
+def convert(data: dict, source: str = "") -> ConvertedScript:
+    """
+    Build a Bottles installer manifest from a loaded Lutris installer.
+    Raises LutrisScriptError listing every problem found.
+    """
+    script = data["script"]
+    errors: list[str] = []
+    warnings: list[str] = []
+
+    runner = data.get("runner")
+    if runner not in WINE_RUNNERS:
+        raise LutrisScriptError(
+            f"This installer uses the '{runner}' runner. Bottles can only "
+            "import installers for Wine."
+        )
+
+    name = str(data.get("name") or script.get("name") or "")
+    if not name:
+        name = os.path.splitext(os.path.basename(source))[0] or "Lutris game"
+    slug = str(
+        data.get("game_slug")
+        or data.get("slug")
+        or re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
+        or "game"
+    )
+
+    game = script.get("game") or {}
+    wine = script.get("wine") or {}
+    system = script.get("system") or {}
+    prefix_expr = str(game.get("prefix") or "$GAMEDIR").rstrip("/")
+    gamedir = _game_dir(prefix_expr, slug)
+
+    files = _parse_files(script.get("files"), errors)
+
+    steps: list[dict] = []
+    inputs: list[dict] = []
+    if files:
+        steps.append({"action": "lutris", "kind": "files"})
+    # Collect known file IDs for insert-disc validation
+    file_ids = {f.id for f in files}
+
+    for command in script.get("installer") or []:
+        if not _check_command(command, errors, warnings, file_ids):
+            continue
+        step = {"action": "lutris", "kind": "command", "command": command}
+        if "input_menu" in command:
+            params = command["input_menu"] or {}
+            step["input"] = str(params.get("id") or f"input{len(inputs)}")
+            inputs.append(menu_spec(params, step["input"]))
+        steps.append(step)
+
+    executable = _executable(game, prefix_expr, gamedir, name, errors)
+
+    if wine.get("version"):
+        warnings.append(
+            f"Wine version '{wine['version']}' is ignored; the bottle's runner is used."
+        )
+
+    overrides = {}
+    for dll, mode in (wine.get("overrides") or {}).items():
+        key = str(mode or "").replace(" ", "").lower()
+        if key not in OVERRIDE_MODES:
+            errors.append(f"Unknown DLL override mode for {dll}: {mode}")
+            continue
+        overrides[str(dll)] = OVERRIDE_MODES[key]
+
+    env = {str(k): str(v) for k, v in (system.get("env") or {}).items()}
+    if overrides or env:
+        steps.append({"action": "lutris", "kind": "config"})
+
+    if errors:
+        raise LutrisScriptError("\n".join(errors))
+
+    parameters = {}
+    for key in ("dxvk", "vkd3d"):
+        if key in wine:
+            parameters[key] = bool(wine[key])
+    if "dxvk_nvapi" in wine:
+        parameters["dxvk_nvapi"] = bool(wine["dxvk_nvapi"])
+    if wine.get("fsync"):
+        parameters["sync"] = "fsync"
+    elif wine.get("esync"):
+        parameters["sync"] = "esync"
+
+    arch = game.get("arch") or wine.get("arch") or "win64"
+
+    manifest: dict = {
+        "Name": name,
+        "Description": f"Imported from the Lutris installer {os.path.basename(source)}".strip(),
+        "Arch": arch,
+        "Executable": executable,
+        "Steps": steps,
+        "LocalResources": [f.label for f in files if f.url is None],
+        "LutrisInputs": inputs,
+        "Lutris": {
+            "slug": slug,
+            "prefix": prefix_expr,
+            "gamedir": gamedir,
+            "files": [f.__dict__ for f in files],
+            "env": env,
+            "overrides": overrides,
+        },
+    }
+    if parameters:
+        manifest["Parameters"] = parameters
+
+    entry = {
+        "Name": name,
+        "Description": manifest["Description"],
+        "Arch": arch,
+        "Grade": "Bronze",
+    }
+    return ConvertedScript(f"lutris:{slug}", entry, manifest, warnings)
+
+
+def winetricks_dependencies(verb: str, available) -> list[str] | None:
+    """
+    The Bottles dependencies standing in for a winetricks verb, or None
+    when there is no match and winetricks itself has to run it.
+    """
+    candidates = WINETRICKS_ALIASES.get(verb, [verb])
+    if all(c in available for c in candidates):
+        return candidates
+    return None
+
+
+def wine_args(args: str) -> str:
+    """
+    Lutris hands wineexec args to wine as an argument list, while Bottles
+    pastes them into a shell command line. Split them like a shell would,
+    but keep backslashes literal (they are Windows paths here), and quote
+    each one so redirections and backslashes reach the Windows program.
+    """
+    lexer = shlex.shlex(args, posix=True)
+    lexer.whitespace_split = True
+    lexer.escape = ""
+    return " ".join(shlex.quote(arg) for arg in lexer)
+
+
+def _file_name(value: Any, files: dict[str, dict]) -> str:
+    """A file id or path as the user would recognise it."""
+    value = str(value or "")
+    f = files.get(value)
+    if f:
+        return f["filename"] or f["label"] or value
+    return os.path.basename(value.replace("\\", "/").rstrip("/")) or value
+
+
+# Wrappers in front of the program a one-line command runs.
+_COMMAND_WRAPPERS = {"env", "exec", "wine", "wine64", "nice", "timeout"}
+
+
+def _single_program(command: str) -> str | None:
+    """The program a command runs, when it is one plain command line."""
+    command = command.strip()
+    if not command or "\n" in command:
+        return None
+    if any(op in command for op in (";", "&", "|", "`", "$(", "<", ">")):
+        return None
+    try:
+        args = shlex.split(command)
+    except ValueError:
+        return None
+    for arg in args:
+        if re.match(r"^\w+=", arg) or arg in _COMMAND_WRAPPERS or arg.startswith("-"):
+            continue
+        return arg
+    return None
+
+
+def _describe_command(command: dict, files: dict[str, dict]) -> tuple[str, str]:
+    name, params = next(iter(command.items()))
+    params = params if isinstance(params, dict) else {}
+    src = _file_name(params.get("file") or params.get("src"), files)
+
+    if name == "task":
+        task = params.get("name")
+        if task == "wineexec":
+            exe = _file_name(params.get("executable"), files)
+            if re.search(r"setup|install", exe, re.IGNORECASE):
+                return "Run installer", exe
+            return "Run program", exe
+        if task == "winetricks":
+            return "Install dependencies", ", ".join(str(params.get("app", "")).split())
+        if task == "winecfg":
+            return "Open Wine settings", "Waits until you close it"
+        if task == "joycpl":
+            return "Open controller settings", "Waits until you close it"
+        if task == "set_regedit":
+            return "Set registry key", str(params.get("key", ""))
+        if task == "delete_registry_key":
+            return "Remove registry key", ""
+        if task == "winekill":
+            return "Stop Wine", ""
+        return "Prepare Wine prefix", ""
+
+    if name == "execute":
+        if params.get("file"):
+            return "Run program", _file_name(params["file"], files)
+        program = _single_program(str(params.get("command", "")))
+        if program:
+            return "Run program", _file_name(program, files)
+        return "Run script", ""
+    if name == "extract":
+        return "Extract files", src
+    if name in ("copy", "merge"):
+        return "Copy files", src
+    if name in ("move", "rename"):
+        return "Move files", src
+    if name == "chmodx":
+        return "Make executable", _file_name(params or command[name], files)
+    if name in ("write_config", "write_json"):
+        return "Write config", _file_name(params.get("file"), files)
+    if name == "write_file":
+        return "Write file", _file_name(params.get("file"), files)
+    if name == "insert-disc":
+        return "Insert disc", src
+    if name == "eject_disc":
+        return "Eject disc", ""
+    return name, ""
+
+
+_INPUT_RE = re.compile(r"\$\{?INPUT_(\w+?)\}?(?![\w}])")
+
+
+def describe_steps(manifest: dict) -> list[dict]:
+    """
+    One entry per step_fn call InstallerManager.install makes for this
+    manifest, in order: the parameters, each step, then registering the
+    game. "hidden" entries are steps the dialog already asked about.
+    "inputs" lists the input_menu ids a step uses.
+    """
+    lutris = manifest["Lutris"]
+    files = {f["id"]: f for f in lutris["files"]}
+    entries = []
+
+    def add(title, subtitle="", hidden=False, inputs=()):
+        entries.append(
+            {"title": title, "subtitle": subtitle, "hidden": hidden, "inputs": list(inputs)}
+        )
+
+    if manifest.get("Parameters"):
+        add("Configure bottle", ", ".join(manifest["Parameters"]))
+
+    for step in manifest["Steps"]:
+        kind = step.get("kind")
+        if kind == "files":
+            downloads = [f["filename"] for f in lutris["files"] if f["url"]]
+            add("Download files", ", ".join(downloads), hidden=not downloads)
+        elif kind == "config":
+            add("Apply Wine settings", "")
+        else:
+            command = step["command"]
+            if "input_menu" in command:
+                add("", hidden=True)
+                continue
+            title, subtitle = _describe_command(command, files)
+            # Lutris shows a command's description as its status line.
+            params = next(iter(command.values()))
+            if isinstance(params, dict) and params.get("description"):
+                title = str(params["description"]).strip()
+            used = dict.fromkeys(m.group(1) for m in _INPUT_RE.finditer(str(command)))
+            add(title, subtitle, inputs=used)
+
+    add("Add to library", manifest["Executable"]["file"])
+    return entries
+
+
+# Shell keywords and builtins that are never what a script step "runs".
+_SCRIPT_NOISE = {
+    "[", "[[", ":", "cd", "echo", "export", "false", "for", "if", "local",
+    "printf", "read", "set", "shift", "test", "true", "while", "case",
+}
+_SCRIPT_CLOSERS = re.compile(r"(do|done|then|else|fi|esac|in|;;|[{}()])\s*;?")
+
+
+def _scan_line(line: str, quote: Optional[str]) -> tuple[str, Optional[str]]:
+    """
+    The parts of a line outside quotes and comments, and the quote still
+    open at its end. Enough shell to find where commands start.
+    """
+    outside, i = [], 0
+    while i < len(line):
+        c = line[i]
+        if quote == "'":
+            if c == "'":
+                quote = None
+        elif quote == '"':
+            if c == "\\":
+                i += 1
+            elif c == '"':
+                quote = None
+        elif c == "\\":
+            i += 1
+        elif c in "'\"":
+            quote = c
+        elif c == "#" and (i == 0 or line[i - 1].isspace()):
+            break
+        else:
+            outside.append(c)
+        i += 1
+    return "".join(outside), quote
+
+
+def script_steps(script: str) -> list[int]:
+    """Line numbers where a script's commands start, skipping blanks,
+    comments, continuations, multi-line strings, here-documents and lone
+    keywords."""
+    steps, heredoc, quote, continued = [], None, None, False
+    for number, raw in enumerate(script.splitlines(), 1):
+        if heredoc:
+            if raw.strip() == heredoc:
+                heredoc = None
+            continue
+        starts_inside = quote is not None or continued
+        outside, quote = _scan_line(raw, quote)
+        continued = quote is None and raw.rstrip().endswith("\\")
+        if re.search(r"(?<!<)<<(?!<)", outside):
+            # The delimiter may be quoted (<<'EOF'), so read it from the raw line.
+            match = re.search(r"(?<!<)<<-?\s*['\"]?(\w+)", raw)
+            heredoc = match.group(1) if match else None
+        line = outside.strip()
+        if starts_inside or not line or _SCRIPT_CLOSERS.fullmatch(line):
+            continue
+        steps.append(number)
+    return steps or [1]
+
+
+def script_command(traced: str) -> Optional[str]:
+    """The program in an xtrace line, as the user would name it."""
+    for word in traced.split():
+        word = word.strip("'\"")
+        if re.match(r"^\w+=", word) or word in ("env", "exec", "wine", "wine64", "nice"):
+            continue
+        if word in _SCRIPT_NOISE:
+            return None
+        return word.replace("\\", "/").rsplit("/", 1)[-1] or None
+    return None
