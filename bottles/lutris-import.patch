+    def __choose_lutris_script(self, *_args):
+        filters = Gio.ListStore.new(Gtk.FileFilter)
+        file_filter = Gtk.FileFilter()
+        file_filter.set_name(_("Lutris Installers"))
+        for pattern in ("*.yml", "*.yaml", "*.json", "*.lutris"):
+            file_filter.add_pattern(pattern)
+        filters.append(file_filter)
+
+        dialog = Gtk.FileDialog.new()
+        dialog.set_title(_("Select a Lutris Installer"))
+        dialog.set_modal(True)
+        dialog.set_filters(filters)
+        dialog.open(self.window, None, self.__lutris_script_chosen)
+
+    def __lutris_script_chosen(self, dialog, result):
+        try:
+            file = dialog.open_finish(result)
+        except GLib.Error:
+            return
+        if not file or not file.get_path():
+            return
+
+        path = file.get_path()
+        try:
+            with open(path, encoding="utf-8") as f:
+                converted = lutris.convert(lutris.load(f.read()), source=path)
+        except (OSError, UnicodeDecodeError, lutris.LutrisScriptError) as e:
+            TextDialog(
+                parent=self.window,
+                title=_("Cannot Import Lutris Installer"),
+                message=str(e),
+            ).present()
+            return
+
+        if converted.entry["Arch"] != self.config.Arch:
+            self.window.show_toast(
+                _("This installer needs a {0} bottle.").format(converted.entry["Arch"])
+            )
+            return
+
+        self.manager.installer_manager.register_local(
+            converted.key, converted.manifest
+        )
+        installer = (converted.key, converted.entry)
+        installer_dialog = InstallerDialog(self.window, self.config, installer)
+        if converted.warnings:
+            installer_dialog.status_init.set_description(
+                "\n".join(converted.warnings)
+                + "\n\n"
+                + _("Do you want to proceed with the installation?")
+            )
+        installer_dialog.present()
diff --git a/bottles/tests/backend/utils/test_lutris.py b/bottles/tests/backend/utils/test_lutris.py
