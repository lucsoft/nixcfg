+logging = Logger()
+
+# Wine builtins a wineexec step may name instead of a file.
+WINE_BUILTINS = {"cmd", "control", "regedit", "reg", "wineboot", "winecfg", "msiexec"}
+
+
+class LutrisStepError(Exception):
+    pass
+
+
+# region process watching
+
+# Wine's own background processes, never what a step is waiting on.
+WINE_SERVICES = {
+    "conhost.exe", "explorer.exe", "plugplay.exe", "rpcss.exe", "rundll32.exe",
+    "services.exe", "start.exe", "svchost.exe", "tabtip.exe", "winedevice.exe",
+    "wineboot.exe", "winemenubuilder.exe", "wineserver",
+}
+SHELLS = {"bash", "sh", "dash", "env", "timeout", "xargs", "nice"}
+CANCELLED = "The installation was aborted."
+
+# Files smaller than this finish too fast to be worth a progress bar.
+MIN_TRACKED_SIZE = 4 << 20
+
+
+def _children() -> dict[int, list[int]]:
+    children: dict[int, list[int]] = {}
+    for entry in os.listdir("/proc"):
+        if not entry.isdigit():
+            continue
+        try:
+            with open(f"/proc/{entry}/stat", encoding="utf-8", errors="replace") as f:
+                # comm may hold spaces and parentheses; ppid follows the last ")"
+                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
+        except (OSError, IndexError, ValueError):
+            continue
+        children.setdefault(ppid, []).append(int(entry))
+    return children
+
+
+def _descendants(pid: int, children: dict[int, list[int]]) -> list[int]:
+    """Breadth first, so the deepest processes come last."""
+    found, queue = [], list(children.get(pid, []))
+    while queue:
+        child = queue.pop(0)
+        found.append(child)
+        queue.extend(children.get(child, []))
+    return found
+
+
+def _process_name(pid: int) -> Optional[str]:
+    """What a process runs, as the user would name it; None for plumbing."""
+    try:
+        with open(f"/proc/{pid}/cmdline", "rb") as f:
+            args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
+        with open(f"/proc/{pid}/comm", encoding="utf-8", errors="replace") as f:
+            comm = f.read().strip()
+    except OSError:
+        return None
+    for arg in args:
+        if arg.lower().endswith(".exe"):
+            name = arg.replace("\\", "/").rsplit("/", 1)[-1]
+            return None if name.lower() in WINE_SERVICES else name
+    if comm in SHELLS or comm in WINE_SERVICES or comm.startswith("wine"):
+        return None
+    return comm
+
+
+def _read_progress(pid: int) -> Optional[tuple[str, float]]:
+    """
+    How far a process has read into the biggest file it has open
+    read-only, the way progress(1) works it out from fdinfo.
+    """
+    best = None
+    try:
+        fds = os.listdir(f"/proc/{pid}/fd")
+    except OSError:
+        return None
+    for fd in fds:
+        try:
+            target = os.readlink(f"/proc/{pid}/fd/{fd}")
+            if not target.startswith("/"):
+                continue
+            with open(f"/proc/{pid}/fdinfo/{fd}", encoding="utf-8") as f:
+                info = dict(
+                    line.split(":", 1) for line in f.read().splitlines() if ":" in line
+                )
+            if int(info["flags"].strip(), 8) & os.O_ACCMODE != os.O_RDONLY:
+                continue
+            pos = int(info["pos"])
+            st = os.stat(target)
+        except (OSError, KeyError, ValueError):
+            continue
+        if not stat.S_ISREG(st.st_mode) or st.st_size < MIN_TRACKED_SIZE:
+            continue
+        if best is None or st.st_size > best[2]:
+            best = (target, pos, st.st_size)
+    if best is None:
+        return None
+    return os.path.basename(best[0]), min(1.0, best[1] / best[2])
+
+
+class ProcessWatcher:
+    """
+    While a step runs, show which program its child processes are running
+    and, where one reads a big file, how far it has got.
+    """
+
+    def __init__(self, activity_fn=None, progress_fn=None, interval: float = 0.5,
+                 cancel_event: Optional[threading.Event] = None, describe=None):
+        # describe(names, progress) -> (text, fraction) replaces the default
+        # "deepest program +others" text, e.g. for scripts.
+        self.describe = describe
+        self.activity_fn = activity_fn
+        self.progress_fn = progress_fn
+        self.cancel_event = cancel_event
+        self.interval = interval
+        self.stop = threading.Event()
+        self.thread = threading.Thread(target=self.__run, daemon=True)
+        self.before: set[int] = set()
+        self.last_text: Optional[str] = None
+        self.last_fraction: Optional[float] = None
+
+    def __enter__(self):
+        self.before = set(_descendants(os.getpid(), _children()))
+        self.thread.start()
+        return self
+
+    def __exit__(self, *_exc):
+        self.stop.set()
+        self.thread.join()
+        if self.last_fraction is not None and self.progress_fn:
+            self.progress_fn(None)
+
+    def __run(self):
+        while not self.stop.wait(self.interval):
+            if self.cancel_event is not None and self.cancel_event.is_set():
+                self.kill()
+                continue
+            try:
+                self.poll()
+            except Exception as e:  # never let watching break an install
+                logging.warning(f"Process watcher: {e}")
+
+    def kill(self):
+        """End what the step started: TERM first, KILL what is left."""
+        for sig, wait in ((signal.SIGTERM, 2.0), (signal.SIGKILL, 0)):
+            pids = [
+                p
+                for p in _descendants(os.getpid(), _children())
+                if p not in self.before
+            ]
+            for pid in pids:
+                try:
+                    os.kill(pid, sig)
+                except OSError:
+                    pass
+            if not pids or self.stop.wait(wait):
+                return
+
+    def poll(self):
+        pids = [
+            p
+            for p in _descendants(os.getpid(), _children())
+            if p not in self.before
+        ]
+        names: list[str] = []
+        progress = None
+        for pid in reversed(pids):
+            name = _process_name(pid)
+            if name and name not in names:
+                names.append(name)
+            progress = progress or _read_progress(pid)
+        if self.describe:
+            text, fraction = self.describe(names, progress)
+        elif not names:
+            return
+        else:
+            # The deepest program, plus how many others run alongside it.
+            text = f"{names[0]} ({progress[0]})" if progress else names[0]
+            if len(names) > 1:
+                text += f" +{len(names) - 1}"
+            fraction = progress[1] if progress else None
+        if text and text != self.last_text and self.activity_fn:
+            self.activity_fn(text)
+            self.last_text = text
+        if self.progress_fn and (
+            fraction is None
+            and self.last_fraction is not None
+            or fraction is not None
+            and abs(fraction - (self.last_fraction or -1)) >= 0.005
+        ):
+            self.progress_fn(fraction)
+            self.last_fraction = fraction
+
+
+class ScriptTrace:
+    """
+    Follow an execute script through bash's xtrace, sent to a pipe of its
+    own: which command runs and how many of the script's commands are left.
+    """
+
+    PREFIX = "PS4='+[${LINENO}] '; set -x\n"  # shifts the script down a line
+
+    def __init__(self, script: str):
+        self.wrapped = self.PREFIX + script
+        self.steps = script_steps(script)
+        self.read_fd, self.write_fd = os.pipe()
+        self.index = 0
+        self.command: Optional[str] = None
+        self.thread = threading.Thread(target=self.__read, daemon=True)
+
+    def run(self, argv, **kwargs) -> subprocess.CompletedProcess:
+        self.thread.start()
+        try:
+            proc = subprocess.Popen(
+                argv,
+                pass_fds=(self.write_fd,),
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+                **kwargs,
+            )
+        finally:
+            os.close(self.write_fd)  # so the reader sees EOF with the script
+        stdout, stderr = proc.communicate()
+        self.thread.join(timeout=5)
+        return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)
+
+    def __read(self):
+        with os.fdopen(self.read_fd, encoding="utf-8", errors="replace") as trace:
+            for line in trace:
+                match = re.match(r"^\++\[(\d+)\] (.*)", line)
+                if not match:
+                    continue
+                number = int(match.group(1)) - 1
+                index = max(0, bisect.bisect_right(self.steps, number) - 1)
+                self.index = max(self.index, index)
+                self.command = script_command(match.group(2)) or self.command
+
+    @property
+    def left(self) -> int:
+        return len(self.steps) - self.index - 1
+
+    def describe(self, names, progress):
+        name = self.command or (names[0] if names else None)
+        text = name or ""
+        if name and progress:
+            text += f" ({progress[0]})"
+        if self.left > 0:
+            text = f"{text} +{self.left}".strip()
+        fraction = (self.index + (progress[1] if progress else 0)) / len(self.steps)
+        return text or None, fraction
+
+
+# endregion
+
+
+class LutrisSession:
+    """State shared by the steps of one Lutris install."""
+
+    def __init__(
+        self,
+        manager,
+        config: BottleConfig,
+        lutris: dict,
+        local_resources: dict,
+        inputs: Optional[dict] = None,
+        progress_fn: Optional[Callable[[Optional[float]], None]] = None,
+        activity_fn: Optional[Callable[[Optional[str]], None]] = None,
+        log_fn: Optional[Callable[[str], None]] = None,
+        cancel_event: Optional[threading.Event] = None,
+    ):
+        self.manager = manager
+        self.cancel_event = cancel_event or threading.Event()
+        self.config = config
+        self.lutris = lutris
+        self.local_resources = local_resources
+        self.inputs = inputs or {}
+        self.progress_fn = progress_fn
+        self.activity_fn = activity_fn
+        self.log_fn = log_fn
+
+        self.prefix = ManagerUtils.get_bottle_path(config)
+        os.makedirs(Paths.temp, exist_ok=True)
+        self.cache = tempfile.mkdtemp(prefix=f"lutris-{lutris['slug']}-", dir=Paths.temp)
+        self.files: dict[str, str] = {}
+        self.variables = {
+            PREFIX_VAR: self.prefix,
+            "CACHE": self.cache,
+            "HOME": os.path.expanduser("~"),
+            "USER": os.environ.get("USER", ""),
+        }
+        self.variables["GAMEDIR"] = expand(lutris["gamedir"], self.variables)
+        os.makedirs(self.variables["GAMEDIR"], exist_ok=True)
+        self._disc_counter = 0  # Tracks total discs inserted (not cleared on eject)
+
+    # region helpers
+
+    def log(self, line: str):
+        logging.info(line)
+        if self.log_fn:
+            self.log_fn(line)
+
+    def activity(self, text: Optional[str]):
+        if self.activity_fn:
+            self.activity_fn(text)
+
+    def resolve(self, value):
+        """Expand variables, after mapping the script's prefix onto the bottle."""
+        prefix = self.lutris.get("prefix")
+
+        def sub_prefix(v):
+            if isinstance(v, str) and prefix:
+                return v.replace(prefix, f"${PREFIX_VAR}")
+            if isinstance(v, list):
+                return [sub_prefix(x) for x in v]
+            if isinstance(v, dict):
+                return {k: sub_prefix(x) for k, x in v.items()}
+            return v
+
+        return expand(sub_prefix(value), self.variables)
+
+    def path(self, value) -> str:
+        """A file id from the files section, or a path."""
+        value = str(value)
+        if value in self.files:
+            return self.files[value]
+        path = self.resolve(value)
+        if not os.path.isabs(path):
+            path = os.path.join(self.variables["GAMEDIR"], path)
+        return path
+
+    def cleanup(self):
+        shutil.rmtree(self.cache, ignore_errors=True)
+
+    # endregion
+
+    def run(self, step: dict) -> Result:
+        if self.cancel_event.is_set():
+            return Result(False, message=CANCELLED)
+        try:
+            kind = step.get("kind")
+            if kind == "files":
+                self.__fetch_files()
+            elif kind == "config":
+                self.__apply_config()
+            elif kind == "command":
+                name, params = next(iter(step["command"].items()))
+                method_name = name.replace("-", "_")
+                if method_name == "input_menu":
+                    self._cmd_input_menu(params, step.get("input", ""))
+                elif self.__reports_itself(method_name, params):
+                    getattr(self, f"_cmd_{method_name}")(params)
+                else:
+                    with ProcessWatcher(
+                        self.activity_fn, self.progress_fn, cancel_event=self.cancel_event
+                    ):
+                        getattr(self, f"_cmd_{method_name}")(params)
+            else:
+                raise LutrisStepError(f"Unknown Lutris step: {kind}")
+        except (LutrisStepError, OSError, subprocess.SubprocessError, ValueError) as e:
+            if self.cancel_event.is_set():
+                return self.__aborted()
+            message = str(e) if isinstance(e, LutrisStepError) else f"Lutris step failed: {e}"
+            self.log(message)
+            return Result(False, message=message)
+        finally:
+            self.activity(None)
+        if self.cancel_event.is_set():
+            return self.__aborted()
+        return Result(True)
+
+    @staticmethod
+    def __reports_itself(method_name: str, params) -> bool:
+        """Commands that tell the dialog more than the process watcher can."""
+        params = params if isinstance(params, dict) else {}
+        if method_name == "execute":
+            return bool(params.get("command"))
+        return method_name == "task" and params.get("name") == "winetricks"
+
+    def __aborted(self) -> Result:
+        self.log(CANCELLED)
+        try:
+            WineServer(self.config).kill()
+        except (OSError, subprocess.SubprocessError):
+            pass
+        return Result(False, message=CANCELLED)
+
+    # region files
+
+    def __fetch_files(self):
+        for f in self.lutris["files"]:
+            if f["url"] is None:
+                path = self.local_resources.get(f["label"])
+                if not path or not os.path.isfile(path):
+                    raise LutrisStepError(f"No file was chosen for '{f['label']}'.")
+            else:
+                path = os.path.join(self.cache, f["filename"])
+                self.__download(f["url"], path)
+            if f.get("checksum"):
+                self.__verify(path, f["checksum"])
+            self.files[f["id"]] = path
+            self.variables[f["id"]] = path
+
+    def __download(self, url: str, path: str):
+        self.activity(os.path.basename(path))
+        self.log(f"Downloading {url}")
+        request = urllib.request.Request(url, headers={"User-Agent": "Bottles"})
+        with urllib.request.urlopen(request, timeout=30) as response:
+            total = int(response.headers.get("Content-Length") or 0)
+            done = 0
+            with open(path, "wb") as out:
+                while chunk := response.read(1 << 20):
+                    if self.cancel_event.is_set():
+                        raise LutrisStepError(CANCELLED)
+                    out.write(chunk)
+                    done += len(chunk)
+                    if total and self.progress_fn:
+                        self.progress_fn(done / total)
+        if self.progress_fn:
+            self.progress_fn(None)
+
+    @staticmethod
+    def __verify(path: str, checksum: str):
+        algo, _, expected = str(checksum).partition(":")
+        if not expected:
+            algo, expected = "md5", algo
+        try:
+            digest = hashlib.new(algo.lower())
+        except ValueError:
+            raise LutrisStepError(f"Unknown checksum type: {algo}")
+        with open(path, "rb") as f:
+            while chunk := f.read(1 << 20):
+                digest.update(chunk)
+        if digest.hexdigest().lower() != expected.lower():
+            raise LutrisStepError(f"Checksum mismatch for {os.path.basename(path)}.")
+
+    # endregion
+
+    # region plain commands
+
+    def _cmd_extract(self, params):
+        params = params or {}
+        src = self.path(params.get("file") or params.get("src"))
+        dst = self.path(params.get("dst", "$GAMEDIR"))
+        fmt = params.get("format")
+        self.activity(os.path.basename(src))
+        self.log(f"Extracting {src} to {dst}")
+
+        os.makedirs(dst, exist_ok=True)
+        tmp = tempfile.mkdtemp(dir=self.cache)
+        if fmt in ("innoextract", "gog") or (
+            fmt is None and src.lower().endswith(".exe")
+        ):
+            if not shutil.which("innoextract"):
+                raise LutrisStepError("innoextract is needed for this installer.")
+            subprocess.run(
+                ["innoextract", "--silent", "--exclude-temp", "-d", tmp, src],
+                check=True,
+            )
+        else:
+            patoolib.extract_archive(src, outdir=tmp, verbosity=-1, interactive=False)
+
+        # Like Lutris, an archive holding a single folder is unwrapped.
+        root = tmp
+        entries = os.listdir(tmp)
+        if len(entries) == 1 and os.path.isdir(os.path.join(tmp, entries[0])):
+            if not params.get("nomerge"):
+                root = os.path.join(tmp, entries[0])
+        shutil.copytree(root, dst, dirs_exist_ok=True, symlinks=True)
+        shutil.rmtree(tmp, ignore_errors=True)
+
+    def _cmd_move(self, params):
+        src, dst = self.path(params["src"]), self.path(params["dst"])
+        self.log(f"Moving {src} to {dst}")
+        if os.path.isdir(dst) and os.path.isdir(src):
+            for entry in os.listdir(src):
+                target = os.path.join(dst, entry)
+                if os.path.isdir(target):
+                    shutil.copytree(os.path.join(src, entry), target, dirs_exist_ok=True)
+                    shutil.rmtree(os.path.join(src, entry))
+                else:
+                    shutil.move(os.path.join(src, entry), target)
+            return
+        os.makedirs(os.path.dirname(dst.rstrip("/")) or "/", exist_ok=True)
+        shutil.move(src, dst)
+
+    def _cmd_merge(self, params):
+        src, dst = self.path(params["src"]), self.path(params["dst"])
+        self.log(f"Copying {src} to {dst}")
+        if os.path.isdir(src):
+            shutil.copytree(src, dst, dirs_exist_ok=True, symlinks=True)
+        else:
+            os.makedirs(dst, exist_ok=True)
+            shutil.copy2(src, dst)
+
+    _cmd_copy = _cmd_merge
+
+    def _cmd_rename(self, params):
+        src, dst = self.path(params["src"]), self.path(params["dst"])
+        os.makedirs(os.path.dirname(dst) or "/", exist_ok=True)
+        os.rename(src, dst)
+
+    def _cmd_chmodx(self, params):
+        path = self.path(params)
+        mode = os.stat(path).st_mode
+        os.chmod(path, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
+
+    def _cmd_execute(self, params):
+        params = params or {}
+        env = {**os.environ, **{str(k): str(v) for k, v in self.resolve(params.get("env") or {}).items()}}
+        env["WINEPREFIX"] = self.prefix
+        cwd = self.path(params["working_dir"]) if params.get("working_dir") else self.cache
+
+        trace = None
+        if params.get("command"):
+            script = self.resolve(str(params["command"]))
+            trace = ScriptTrace(script)
+            argv = ["bash", "-c", trace.wrapped]
+            env["BASH_XTRACEFD"] = str(trace.write_fd)
+            label = "shell command"
+        else:
+            program = self.path(params["file"])
+            argv = [program, *shlex.split(self.resolve(str(params.get("args", ""))))]
+            label = os.path.basename(program)
+
+        self.activity(label)
+        self.log(f"Running {' '.join(argv)}")
+        if trace is None:
+            proc = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True)
+        else:
+            with ProcessWatcher(
+                self.activity_fn,
+                self.progress_fn,
+                cancel_event=self.cancel_event,
+                describe=trace.describe,
+            ):
+                proc = trace.run(argv, cwd=cwd, env=env)
+        for line in f"{proc.stdout}\n{proc.stderr}".splitlines():
+            if line and self.log_fn:
+                self.log_fn(line[:500])
+        expected = {int(c) for c in str(params.get("return_code", "0")).split(",")}
+        if proc.returncode not in expected:
+            raise LutrisStepError(f"{label} exited with status {proc.returncode}.")
+
+    def _cmd_write_file(self, params):
+        path = self.path(params["file"])
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as f:
+            f.write(self.resolve(str(params.get("content", ""))))
+
+    def _cmd_write_config(self, params):
+        path = self.path(params["file"])
+        parser = configparser.RawConfigParser(strict=False, interpolation=None)
+        parser.optionxform = str  # keep the key case the game expects
+        if os.path.isfile(path) and params.get("merge", True):
+            parser.read(path, encoding="utf-8")
+
+        data = self.resolve(params.get("data") or {})
+        if params.get("section"):
+            data = {params["section"]: {params["key"]: self.resolve(params.get("value", ""))}}
+        for section, values in data.items():
+            if not parser.has_section(section):
+                parser.add_section(section)
+            for key, value in (values or {}).items():
+                parser.set(section, key, str(value))
+
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as f:
+            parser.write(f, space_around_delimiters=False)
+
+    def _cmd_write_json(self, params):
+        path = self.path(params["file"])
+        data = self.resolve(params.get("data") or {})
+        if os.path.isfile(path) and params.get("merge", True):
+            with open(path, encoding="utf-8") as f:
+                current = json.load(f)
+
+            def merge(a, b):
+                for k, v in b.items():
+                    if isinstance(v, dict) and isinstance(a.get(k), dict):
+                        merge(a[k], v)
+                    else:
+                        a[k] = v
+                return a
+
+            data = merge(current, data)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(data, f, indent=2)
+
+    def _cmd_input_menu(self, params, key: str):
+        choice = self.inputs.get(key)
+        if choice is None:
+            # No dialog asked, e.g. a scripted install: take the default.
+            choice = menu_spec(params, key)["default"]
+        self.log(f"Using '{choice}' for {key}")
+        self.variables["INPUT"] = str(choice)
+        if params.get("id"):
+            self.variables[f"INPUT_{params['id']}"] = str(choice)
+
+    def _cmd_insert_disc(self, params):
+        self.log(f"DEBUG _cmd_insert_disc called with params: {params}")
+        params = params or {}
+        file_id = params.get("file") or params.get("src")
+        if not file_id:
+            raise LutrisStepError("insert-disc requires a 'file' or 'src' parameter.")
+
+        # Resolve the file path (ISO) using the same mechanism as extract
+        iso_path = self.path(file_id)
+        if not os.path.isfile(iso_path):
+            raise LutrisStepError(f"insert-disc: file not found: {iso_path}")
+
+        self.activity(os.path.basename(iso_path))
+        self.log(f"Inserting disc {iso_path} as D:")
+
+        # Extract ISO to a cache directory using 7z (patoolib has issues with ISOs)
+        disc_dir = tempfile.mkdtemp(prefix="disc-", dir=self.cache)
+        self.log(f"Extracting ISO {iso_path} to {disc_dir}")
+        try:
+            # Use 7z for reliable ISO extraction
+            result = subprocess.run(
+                ["7z", "x", iso_path, f"-o{disc_dir}", "-y"],
+                capture_output=True,
+                text=True,
+                timeout=300,
+            )
+            if result.returncode != 0:
+                shutil.rmtree(disc_dir, ignore_errors=True)
+                raise LutrisStepError(f"Failed to extract ISO: {result.stderr}")
+        except subprocess.TimeoutExpired:
+            shutil.rmtree(disc_dir, ignore_errors=True)
+            raise LutrisStepError("ISO extraction timed out")
+        except Exception as e:
+            shutil.rmtree(disc_dir, ignore_errors=True)
+            raise LutrisStepError(f"Failed to extract ISO: {e}")
+
+        # Map D: drive in Wine using dosdevices symlink (primary method)
+        # Wine reads drive mappings from <prefix>/dosdevices/<letter>:
+        dosdevices = os.path.join(self.prefix, "dosdevices")
+        os.makedirs(dosdevices, exist_ok=True)
+        d_drive = os.path.join(dosdevices, "d:")
+        if os.path.lexists(d_drive):
+            os.unlink(d_drive)
+        os.symlink(disc_dir, d_drive)
+        self.log(f"Mapped D: to {disc_dir} via dosdevices symlink")
+
+        # Also set registry key for compatibility (HKCU\Software\Wine\Drives)
+        reg = Reg(self.config)
+        reg.add(
+            key=r"Software\Wine\Drives",
+            value="d:",
+            data=disc_dir,
+            value_type="REG_SZ",
+        )
+        self.log(f"Set D: registry mapping to {disc_dir}")
+
+        # Store for eject_disc to clean up
+        if not hasattr(self, "_disc_dirs"):
+            self._disc_dirs = []
+        self._disc_dirs.append(disc_dir)
+
+        # Also store as variable for use in execute steps (DISC1, DISC2, etc.)
+        self._disc_counter += 1
+        disc_num = self._disc_counter
+        self.variables[f"DISC{disc_num}"] = disc_dir
+        self.log(f"DEBUG: Set variable DISC{disc_num} = {disc_dir}")
+        self.log(f"Disc {disc_num} available as $DISC{disc_num} = {disc_dir}")
+
+    def _cmd_eject_disc(self, params):
+        self.activity("Eject disc")
+        self.log("Ejecting disc (removing D: mapping)")
+
+        # Remove D: drive dosdevices symlink
+        dosdevices = os.path.join(self.prefix, "dosdevices")
+        d_drive = os.path.join(dosdevices, "d:")
+        if os.path.lexists(d_drive):
+            os.unlink(d_drive)
+            self.log("Removed D: dosdevices symlink")
+
+        # Remove D: drive registry mapping
+        reg = Reg(self.config)
+        reg.launch(
+            r"delete 'HKCU\Software\Wine\Drives' /v d: /f",
+            communicate=True,
+            minimal=True,
+            action_name="delete",
+        )
+        self.log("Removed D: registry mapping")
+
+        # Clean up extracted disc directories
+        if hasattr(self, "_disc_dirs"):
+            for disc_dir in self._disc_dirs:
+                shutil.rmtree(disc_dir, ignore_errors=True)
+            self._disc_dirs.clear()
+
+    def _cmd_task(self, params):
+        getattr(self, f"_task_{params['name']}")(params)
+
+    # endregion
+
+    # region wine tasks
+
+    def _task_create_prefix(self, params):
+        # Bottles already created and booted the prefix.
+        pass
+
+    def _task_wineexec(self, params):
+        executable = str(params["executable"])
+        args = self.resolve(str(params.get("args", "")))
+        env = {str(k): str(v) for k, v in self.resolve(params.get("env") or {}).items()}
+        self.activity(os.path.basename(executable))
+        args = wine_args(args)
+        self.log(f"Running {executable} {args}".strip())
+
+        if executable.lower() in WINE_BUILTINS:
+            result = WineCommand(
+                self.config,
+                command=executable,
+                arguments=args,
+                communicate=True,
+                environment=env,
+            ).run()
+        else:
+            cwd = self.path(params["working_dir"]) if params.get("working_dir") else None
+            result = WineExecutor(
+                self.config,
+                exec_path=self.path(executable),
+                args=args,
+                environment=env,
+                cwd=cwd,
+            ).run()
+        if not result.ok:
+            raise LutrisStepError(result.message or f"{executable} failed.")
+
+    def _task_winetricks(self, params):
+        available = self.manager.supported_dependencies
+        units = []  # (dependency or None, winetricks verb)
+        for verb in str(params.get("app", "")).split():
+            deps = winetricks_dependencies(verb, available)
+            if deps is None:
+                units.append((None, verb))
+            else:
+                units += [
+                    (dep, verb)
+                    for dep in deps
+                    if dep not in self.config.Installed_Dependencies
+                ]
+
+        # Show only what installs right now, plus how many are left.
+        for i, (dep, verb) in enumerate(units):
+            if self.cancel_event.is_set():
+                raise LutrisStepError(CANCELLED)
+            left = len(units) - i - 1
+            self.activity(f"{dep or verb} +{left}" if left else dep or verb)
+            if self.progress_fn:
+                self.progress_fn(i / len(units))
+            if dep is None:
+                self.__winetricks(verb)
+                continue
+            self.log(f"Installing dependency {dep} for winetricks {verb}")
+            res = self.manager.dependency_manager.install(
+                self.config, [dep, available.get(dep)]
+            )
+            if not res.ok:
+                raise LutrisStepError(res.message or f"Failed to install {dep}.")
+        if units and self.progress_fn:
+            self.progress_fn(None)
+
+    def __winetricks(self, verb: str):
+        winetricks = shutil.which("winetricks")
+        if not winetricks:
+            raise LutrisStepError(
+                f"winetricks {verb} has no Bottles dependency, and winetricks "
+                "is not installed to run it directly."
+            )
+        runner = ManagerUtils.get_runner_path(self.config.Runner)
+        wine = next(
+            (
+                p
+                for p in (f"{runner}/bin/wine", f"{runner}/files/bin/wine")
+                if os.path.isfile(p)
+            ),
+            None,
+        )
+        env = {**os.environ, "WINEPREFIX": self.prefix}
+        if wine:
+            env["WINE"] = wine
+            env["WINESERVER"] = os.path.join(os.path.dirname(wine), "wineserver")
+        self.log(f"Running winetricks {verb}")
+        proc = subprocess.run(
+            [winetricks, "--unattended", verb], env=env, capture_output=True, text=True
+        )
+        for line in f"{proc.stdout}\n{proc.stderr}".splitlines():
+            if line and self.log_fn:
+                self.log_fn(line[:500])
+        if proc.returncode:
+            raise LutrisStepError(f"winetricks {verb} exited with status {proc.returncode}.")
+
+    def _task_set_regedit(self, params):
+        Reg(self.config).add(
+            key=self.resolve(str(params["path"])),
+            value=self.resolve(str(params["key"])),
+            data=self.resolve(str(params.get("value", ""))),
+            value_type=params.get("type", "REG_SZ"),
+        )
+
+    def _task_delete_registry_key(self, params):
+        key = self.resolve(str(params["key"]))
+        Reg(self.config).launch(
+            f"delete '{key}' /f", communicate=True, minimal=True, action_name="delete"
+        )
+
+    def __wait_for(self, command: str, arguments: str = ""):
+        """Open a Wine tool and wait until the user closes it."""
+        self.activity("Waiting for you to close the window")
+        self.log(f"Running {command} {arguments}".strip())
+        result = WineCommand(
+            self.config, command=command, arguments=arguments, communicate=True
+        ).run()
+        if not result.ok:
+            raise LutrisStepError(result.message or f"{command} failed.")
+
+    def _task_winecfg(self, params):
+        self.__wait_for("winecfg")
+
+    def _task_joycpl(self, params):
+        self.__wait_for("control", "joy.cpl")
+
+    def _task_winekill(self, params):
+        WineServer(self.config).stop()
+
+    # endregion
+
+    def __apply_config(self):
+        for key, value in self.lutris["overrides"].items():
+            self.manager.update_config(
+                config=self.config, key=key, value=value, scope="DLL_Overrides"
+            )
+        for key, value in self.lutris["env"].items():
+            self.manager.update_config(
+                config=self.config,
+                key=key,
+                value=self.resolve(value),
+                scope="Environment_Variables",
+            )
