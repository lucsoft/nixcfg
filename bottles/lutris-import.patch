+"""
+Install a game from a Lutris installer script: review what the script
+will do, collect files and choices up front, then show the same step
+list live while it runs. Without a bottle it creates one first.
+"""
+
+import os
+import threading
+import urllib.parse
+from gettext import gettext as _
+from typing import Callable, Optional
+
+from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk
+
+from bottles.backend.utils import lutris
+from bottles.backend.utils.threading import RunAsync
+from bottles.frontend.utils.gtk import GtkUtils
+from bottles.frontend.windows.generic import TextDialog
+from bottles.frontend.windows.installer import fetch_installer_icon
+
+LUTRIS_ICON_URL = "https://lutris.net/games/icon/{0}.png"
+
+def choose_lutris_script(
+    window, on_converted: Callable[[lutris.ConvertedScript, str], None]
+):
+    """Ask for a Lutris script and hand over the converted installer."""
+    filters = Gio.ListStore.new(Gtk.FileFilter)
+    file_filter = Gtk.FileFilter()
+    file_filter.set_name(_("Lutris Installers"))
+    for pattern in ("*.yml", "*.yaml", "*.json", "*.lutris"):
+        file_filter.add_pattern(pattern)
+    filters.append(file_filter)
+
+    def chosen(dialog, result):
+        try:
+            file = dialog.open_finish(result)
+        except GLib.Error:
+            return
+        if not file or not file.get_path():
+            return
+        path = file.get_path()
+        try:
+            with open(path, encoding="utf-8") as f:
+                converted = lutris.convert(lutris.load(f.read()), source=path)
+        except (OSError, UnicodeDecodeError, lutris.LutrisScriptError) as e:
+            TextDialog(
+                parent=window,
+                title=_("Cannot Import Lutris Installer"),
+                message=str(e),
+            ).present()
+            return
+        on_converted(converted, path)
+
+    dialog = Gtk.FileDialog.new()
+    dialog.set_title(_("Select a Lutris Installer"))
+    dialog.set_modal(True)
+    dialog.set_filters(filters)
+    dialog.open(window, None, chosen)
+
+
+class StepRow(Adw.ActionRow):
+    """One step, with its state as the prefix icon."""
+
+    def __init__(self, number: int, title: str, subtitle: str = ""):
+        super().__init__(title=title, use_markup=False, subtitle_lines=1)
+        self.subtitle = subtitle
+
+        self.state = Gtk.Stack(width_request=24, valign=Gtk.Align.CENTER)
+        self.state.add_named(
+            Gtk.Label(label=str(number), css_classes=["dim-label", "numeric"]),
+            "pending",
+        )
+        spinner = Adw.Spinner() if hasattr(Adw, "Spinner") else Gtk.Spinner(spinning=True)
+        self.state.add_named(spinner, "running")
+        self.state.add_named(
+            Gtk.Image(icon_name="object-select-symbolic", css_classes=["success"]),
+            "done",
+        )
+        self.state.add_named(
+            Gtk.Image(icon_name="dialog-error-symbolic", css_classes=["error"]),
+            "failed",
+        )
+        self.add_prefix(self.state)
+
+        self.progress = Gtk.ProgressBar(
+            visible=False, valign=Gtk.Align.CENTER, width_request=80
+        )
+        self.add_suffix(self.progress)
+        self.set_subtitle(subtitle)
+
+    def set_subtitle(self, subtitle: str):
+        self.subtitle = subtitle
+        self.show_subtitle(subtitle)
+
+    def show_subtitle(self, text: Optional[str]):
+        """Show text without forgetting the step's own subtitle."""
+        text = (text or self.subtitle or "").strip().splitlines()
+        super().set_subtitle(text[0] if text else "")
+
+    def set_state(self, state: str):
+        self.state.set_visible_child_name(state)
+        if state != "running":
+            self.progress.set_visible(False)
+            self.show_subtitle(None)
+
+    def set_progress(self, fraction: Optional[float]):
+        self.progress.set_visible(fraction is not None)
+        if fraction is not None:
+            self.progress.set_fraction(max(0.0, min(1.0, fraction)))
+
+
+class LutrisInstallerDialog(Adw.Dialog):
+    def __init__(self, window, converted: lutris.ConvertedScript, source: str,
+                 config=None, **kwargs):
+        super().__init__(**kwargs)
+        self.window = window
+        self.manager = window.manager
+        self.converted = converted
+        self.manifest = converted.manifest
+        self.config = config
+        self.new_bottle = config is None
+        self.entries = lutris.describe_steps(self.manifest)
+
+        self.inputs: dict[str, str] = {}
+        self.input_labels: dict[str, str] = {}
+        self.resources: dict[str, str] = {}
+        self.install_rows: dict[int, StepRow] = {}
+        self.create_row: Optional[StepRow] = None
+        self.current = -1
+        self.log_lines: list[str] = []
+        self.cancel_event = threading.Event()
+        self.delete_on_abort = False
+        self.connect("close-attempt", self.__ask_abort)
+
+        name = self.manifest["Name"]
+        self.set_title(name)
+        self.set_content_width(520)
+        self.set_content_height(640)
+
+        files = self.manifest["Lutris"]["files"]
+        self.local_files = [f for f in files if f["url"] is None]
+        self.specs = self.manifest.get("LutrisInputs") or []
+
+        # Setup: bottle and options first, then the files, then installing.
+        self.nav = Adw.NavigationView()
+        self.btn_setup = None
+        self.btn_files = None
+        self.nav.add(self.__setup_page(name, source))
+        if self.local_files:
+            self.nav.add(self.__files_page(name, source))
+
+        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
+        self.stack.add_named(self.nav, "setup")
+        self.stack.add_named(self.__run_view(name), "run")
+        self.set_child(self.stack)
+
+        self.__refresh_subtitles()
+        self.__validate()
+
+    # region setup
+
+    def __page(self, title: str, tag: str, content: Gtk.Widget, button: Gtk.Button,
+               cancel: bool) -> Adw.NavigationPage:
+        header = Adw.HeaderBar(show_end_title_buttons=False,
+                               show_start_title_buttons=False)
+        if cancel:
+            btn_cancel = Gtk.Button(label=_("Cancel"))
+            btn_cancel.connect("clicked", lambda *_: self.close())
+            header.pack_start(btn_cancel)
+        header.pack_end(button)
+        toolbar = Adw.ToolbarView(content=content)
+        toolbar.add_top_bar(header)
+        return Adw.NavigationPage(title=title, tag=tag, child=toolbar)
+
+    def __hero(self, name: str, source: str) -> Adw.PreferencesGroup:
+        hero = Adw.PreferencesGroup()
+        box = Gtk.Box(spacing=14)
+        icon = Gtk.Image(icon_name="applications-games-symbolic", pixel_size=64)
+        box.append(icon)
+        self.__fetch_icon(icon)
+        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
+        text.append(Gtk.Label(label=name, xalign=0, wrap=True, css_classes=["title-2"]))
+        text.append(
+            Gtk.Label(label=os.path.basename(source), xalign=0, css_classes=["dim-label"])
+        )
+        box.append(text)
+        hero.add(box)
+        return hero
+
+    def __fetch_icon(self, image: Gtk.Image):
+        """The game's icon from lutris.net, if it has one for the slug."""
+        url = LUTRIS_ICON_URL.format(urllib.parse.quote(self.manifest["Lutris"]["slug"]))
+
+        def set_icon(data, error=None):
+            if error or not data:
+                return
+            try:
+                image.set_from_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(data)))
+            except GLib.Error:
+                pass
+
+        RunAsync(fetch_installer_icon, callback=set_icon, url=url)
+
+    def __notes(self) -> Optional[Adw.PreferencesGroup]:
+        if not self.converted.warnings:
+            return None
+        return Adw.PreferencesGroup(
+            title=_("Notes"), description="\n".join(self.converted.warnings)
+        )
+
+    def __setup_page(self, name: str, source: str) -> Adw.NavigationPage:
+        page = Adw.PreferencesPage()
+        page.add(self.__hero(name, source))
+
+        if self.new_bottle:
+            group = Adw.PreferencesGroup(title=_("New Bottle"))
+            self.entry_name = Adw.EntryRow(title=_("Name"), text=name)
+            self.entry_name.connect("changed", self.__validate)
+            group.add(self.entry_name)
+            self.runners = list(self.manager.runners_available)
+            self.combo_runner = Adw.ComboRow(
+                title=_("Runner"), model=Gtk.StringList.new(self.runners)
+            )
+            latest = self.manager.get_latest_runner()
+            if latest in self.runners:
+                self.combo_runner.set_selected(self.runners.index(latest))
+            group.add(self.combo_runner)
+            page.add(group)
+
+        group = Adw.PreferencesGroup(title=_("Options"))
+        for spec in self.specs:
+            group.add(self.__input_row(spec))
+        self.switch_menu = Adw.SwitchRow(
+            title=_("Add to App Menu"), active=True
+        )
+        group.add(self.switch_menu)
+        page.add(group)
+
+        if notes := self.__notes():
+            page.add(notes)
+
+        if self.local_files:
+            self.btn_setup = Gtk.Button(label=_("Next"), css_classes=["suggested-action"])
+            self.btn_setup.connect("clicked", lambda *_: self.nav.push_by_tag("files"))
+        else:
+            self.btn_setup = Gtk.Button(label=_("Install"), css_classes=["suggested-action"])
+            self.btn_setup.connect("clicked", self.__install)
+        return self.__page(_("Lutris Installer"), "setup", page, self.btn_setup, True)
+
+    def __files_page(self, name: str, source: str) -> Adw.NavigationPage:
+        page = Adw.PreferencesPage()
+        group = Adw.PreferencesGroup(
+            title=_("Your Files"),
+            description=_("The installer needs these files from you."),
+        )
+        for f in self.local_files:
+            group.add(self.__file_row(f))
+        page.add(group)
+
+        downloads = [f for f in self.manifest["Lutris"]["files"] if f["url"]]
+        if downloads:
+            group = Adw.PreferencesGroup(
+                title=_("Downloads"),
+                description=_("Fetched during the installation."),
+            )
+            for f in downloads:
+                group.add(
+                    Adw.ActionRow(
+                        title=f["filename"],
+                        subtitle=urllib.parse.urlsplit(f["url"]).hostname or "",
+                        use_markup=False,
+                    )
+                )
+            page.add(group)
+
+        self.btn_files = Gtk.Button(label=_("Install"), css_classes=["suggested-action"])
+        self.btn_files.connect("clicked", self.__install)
+        return self.__page(_("Files"), "files", page, self.btn_files, False)
+
+    def __file_row(self, f: dict) -> Adw.ActionRow:
+        row = Adw.ActionRow(title=f["label"], subtitle=_("No file chosen"))
+        check = Gtk.Image(
+            icon_name="object-select-symbolic", visible=False, css_classes=["success"]
+        )
+        button = Gtk.Button(
+            icon_name="document-open-symbolic",
+            tooltip_text=_("Choose File"),
+            valign=Gtk.Align.CENTER,
+            css_classes=["flat"],
+        )
+        row.add_suffix(check)
+        row.add_suffix(button)
+        row.set_activatable_widget(button)
+
+        def chosen(dialog, result):
+            try:
+                file = dialog.open_finish(result)
+            except GLib.Error:
+                return
+            if not file or not file.get_path():
+                return
+            self.resources[f["label"]] = file.get_path()
+            row.set_subtitle(file.get_path())
+            check.set_visible(True)
+            self.__refresh_subtitles()
+            self.__validate()
+
+        def choose(*_args):
+            dialog = Gtk.FileDialog.new()
+            dialog.set_title(f["label"])
+            dialog.set_modal(True)
+            dialog.open(self.get_root(), None, chosen)
+
+        button.connect("clicked", choose)
+        return row
+
+    def __input_row(self, spec: dict) -> Adw.ComboRow:
+        values = [value for value, _label in spec["options"]]
+        labels = [label for _value, label in spec["options"]]
+        row = Adw.ComboRow(title=spec["description"], model=Gtk.StringList.new(labels))
+        row.set_selected(values.index(spec["default"]))
+        key = spec["key"]
+        self.inputs[key] = spec["default"]
+        self.input_labels[key] = labels[values.index(spec["default"])]
+
+        def changed(combo, _param):
+            self.inputs[key] = values[combo.get_selected()]
+            self.input_labels[key] = labels[combo.get_selected()]
+            self.__refresh_subtitles()
+
+        row.connect("notify::selected", changed)
+        return row
+
+    def __step_list(self, rows: dict[int, StepRow]) -> Gtk.ListBox:
+        listbox = Gtk.ListBox(
+            selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"]
+        )
+        number = 1
+        if self.new_bottle:
+            self.create_row = StepRow(number, _("Create bottle"))
+            listbox.append(self.create_row)
+            number += 1
+        for i, entry in enumerate(self.entries):
+            if entry["hidden"]:
+                continue
+            row = StepRow(number, entry["title"], entry["subtitle"])
+            listbox.append(row)
+            rows[i] = row
+            number += 1
+        return listbox
+
+    def __refresh_subtitles(self):
+        """Steps show the files and choices picked above."""
+        for i, row in self.install_rows.items():
+            entry = self.entries[i]
+            used = [self.input_labels[k] for k in entry["inputs"]
+                    if k in self.input_labels]
+            if used:
+                row.set_subtitle(", ".join(used))
+            elif entry["subtitle"] in self.resources:
+                row.set_subtitle(os.path.basename(self.resources[entry["subtitle"]]))
+
+    def __validate(self, *_args):
+        setup_ok = True
+        if self.new_bottle:
+            name = self.entry_name.get_text().strip()
+            taken = name in self.manager.local_bottles
+            if taken:
+                self.entry_name.add_css_class("error")
+            else:
+                self.entry_name.remove_css_class("error")
+            setup_ok = bool(name) and not taken and bool(self.runners)
+        files_ok = all(f["label"] in self.resources for f in self.local_files)
+        if self.btn_setup:
+            self.btn_setup.set_sensitive(setup_ok)
+        if self.btn_files:
+            self.btn_files.set_sensitive(setup_ok and files_ok)
+
+    # endregion
+
+    # region install
+
+    def __run_view(self, name: str) -> Gtk.Widget:
+        """Installing and done, under a header of their own."""
+        self.run_title = Adw.WindowTitle(title=_("Installing {0}").format(name))
+        header = Adw.HeaderBar(
+            title_widget=self.run_title,
+            show_start_title_buttons=False,
+            show_end_title_buttons=False,
+        )
+        self.btn_log = Gtk.ToggleButton(label=_("Log"))
+        self.btn_close = Gtk.Button(label=_("Close"), visible=False)
+        self.btn_close.connect("clicked", lambda *_: self.close())
+        self.btn_abort = Gtk.Button(label=_("Abort"))
+        self.btn_abort.connect("clicked", self.__ask_abort)
+        header.pack_start(self.btn_close)
+        header.pack_start(self.btn_abort)
+        header.pack_end(self.btn_log)
+        self.progress = Gtk.ProgressBar(css_classes=["osd"])
+
+        self.run_stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
+        self.run_stack.add_named(self.__install_page(), "install")
+        self.run_stack.add_named(self.__done_page(name), "done")
+        toolbar = Adw.ToolbarView(content=self.run_stack)
+        toolbar.add_top_bar(header)
+        toolbar.add_top_bar(self.progress)
+        return toolbar
+
+    def __install_page(self) -> Gtk.Widget:
+        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
+        box.set_margin_top(12)
+        box.set_margin_bottom(12)
+        box.set_margin_start(12)
+        box.set_margin_end(12)
+        self.install_list = self.__step_list(self.install_rows)
+        box.append(self.install_list)
+
+        self.log_view = Gtk.TextView(
+            editable=False,
+            cursor_visible=False,
+            monospace=True,
+            wrap_mode=Gtk.WrapMode.WORD_CHAR,
+            top_margin=8,
+            bottom_margin=8,
+            left_margin=8,
+            right_margin=8,
+        )
+        scrolled_log = Gtk.ScrolledWindow(
+            height_request=180, child=self.log_view, css_classes=["card"]
+        )
+        revealer = Gtk.Revealer(child=scrolled_log)
+        self.btn_log.bind_property(
+            "active", revealer, "reveal-child", GObject.BindingFlags.SYNC_CREATE
+        )
+        box.append(revealer)
+
+        clamp = Adw.Clamp(maximum_size=600, child=box)
+        return Gtk.ScrolledWindow(
+            child=clamp, hscrollbar_policy=Gtk.PolicyType.NEVER
+        )
+
+    def __done_page(self, name: str) -> Gtk.Widget:
+        self.status_done = Adw.StatusPage(
+            icon_name="selection-mode-symbolic", title=_("Installed")
+        )
+        button = Gtk.Button(
+            label=_("Show Programs"),
+            halign=Gtk.Align.CENTER,
+            css_classes=["pill", "suggested-action"],
+        )
+        button.connect("clicked", self.__show_programs)
+        self.status_done.set_child(button)
+        return self.status_done
+
+    def __install(self, *_args):
+        self.set_can_close(False)
+        self.__refresh_subtitles()
+        self.stack.set_visible_child_name("run")
+
+        if not self.new_bottle:
+            self.__start_install()
+            return
+
+        name = self.entry_name.get_text().strip()
+        self.create_row.set_state("running")
+        RunAsync(
+            task_func=self.manager.create_bottle,
+            callback=self.__created,
+            name=name,
+            environment="gaming",
+            runner=self.runners[self.combo_runner.get_selected()],
+            arch=self.manifest["Arch"],
+            dxvk=self.manager.dxvk_available[0] if self.manager.dxvk_available else False,
+            fn_logger=self.__creation_log,
+            cancel_event=self.cancel_event,
+        )
+
+    @GtkUtils.run_in_main_loop
+    def __creation_log(self, text: str):
+        text = text.strip()
+        if text:
+            self.create_row.show_subtitle(text)
+            self.__log(text)
+
+    @GtkUtils.run_in_main_loop
+    def __created(self, result, error=None):
+        config = (result.data or {}).get("config") if result else None
+        if self.cancel_event.is_set():
+            if config and result.status:
+                self.manager.check_bottles()
+                self.config = self.manager.local_bottles.get(config.Name, config)
+            self.__aborted()
+            return
+        if error or not result or not result.status or not config:
+            self.__fail(self.create_row, _("The bottle could not be created."))
+            return
+        self.manager.check_bottles()
+        # check_bottles reloads every config; install into the one the UI holds.
+        self.config = self.manager.local_bottles.get(config.Name, config)
+        self.window.page_list.update_bottles_list()
+        self.create_row.set_state("done")
+        self.__start_install()
+
+    def __start_install(self):
+        im = self.manager.installer_manager
+        self.manifest["Executable"]["desktop_entry"] = (
+            "manual" if self.switch_menu.get_active() else "none"
+        )
+        im.register_local(self.converted.key, self.manifest)
+        RunAsync(
+            task_func=im.install,
+            callback=self.__finished,
+            config=self.config,
+            installer=(self.converted.key, self.converted.entry),
+            step_fn=self.__next_step,
+            local_resources=self.resources,
+            progress_fn=self.__step_progress,
+            activity_fn=self.__step_activity,
+            log_fn=self.__log_threadsafe,
+            inputs=self.inputs,
+            cancel_event=self.cancel_event,
+        )
+
+    def __total(self) -> int:
+        return len(self.entries) + (1 if self.new_bottle else 0)
+
+    def __completed(self) -> int:
+        return max(self.current, 0) + (1 if self.new_bottle else 0)
+
+    def __overall(self, fraction: float = 0.0):
+        self.progress.set_fraction((self.__completed() + fraction) / self.__total())
+
+    @GtkUtils.run_in_main_loop
+    def __next_step(self, *_args):
+        if row := self.install_rows.get(self.current):
+            row.set_state("done")
+        self.current += 1
+        if row := self.install_rows.get(self.current):
+            row.set_state("running")
+            row.grab_focus()
+        self.__overall()
+
+    @GtkUtils.run_in_main_loop
+    def __step_progress(self, fraction: Optional[float]):
+        if row := self.install_rows.get(self.current):
+            row.set_progress(fraction)
+        self.__overall(fraction or 0.0)
+
+    @GtkUtils.run_in_main_loop
+    def __step_activity(self, text: Optional[str]):
+        if row := self.install_rows.get(self.current):
+            row.show_subtitle(text)
+
+    def __log_threadsafe(self, line: str):
+        GLib.idle_add(self.__log, line)
+
+    def __log(self, line: str):
+        if not line:
+            return
+        self.log_lines = (self.log_lines + [line])[-300:]
+        buffer = self.log_view.get_buffer()
+        buffer.set_text("\n".join(self.log_lines))
+        self.log_view.scroll_to_iter(buffer.get_end_iter(), 0, False, 0, 0)
+
+    @GtkUtils.run_in_main_loop
+    def __finished(self, result, error=None):
+        if self.cancel_event.is_set():
+            self.__aborted()
+            return
+        if result is not None and result.ok and not error:
+            self.btn_abort.set_visible(False)
+            for row in self.install_rows.values():
+                row.set_state("done")
+            self.progress.set_fraction(1)
+            self.progress.set_visible(False)
+            self.btn_log.set_visible(False)
+            self.status_done.set_description(
+                _("{0} is now in the programs of “{1}”.").format(
+                    self.manifest["Name"], self.config.Name
+                )
+            )
+            self.run_title.set_title("")
+            self.run_stack.set_visible_child_name("done")
+            self.set_can_close(True)
+            self.__reload_programs()
+            return
+
+        message = str(error) if error else _("Installer failed unexpectedly")
+        if result is not None:
+            message = result.message or (result.data or {}).get("message") or message
+        row = self.install_rows.get(self.current)
+        if row is None:
+            # A hidden step failed; blame the next visible one.
+            row = next(
+                (r for i, r in sorted(self.install_rows.items()) if i > self.current),
+                None,
+            )
+        self.__fail(row, message)
+
+    def __fail(self, row: Optional[StepRow], message: str):
+        if row:
+            row.set_state("failed")
+            row.set_subtitle(message)
+        self.__log(message)
+        self.run_title.set_title(_("Installation Failed"))
+        self.btn_log.set_active(True)
+        self.btn_abort.set_visible(False)
+        self.btn_close.set_visible(True)
+        self.progress.set_visible(False)
+        self.set_can_close(True)
+
+    def __ask_abort(self, *_args):
+        if self.stack.get_visible_child_name() != "run" or self.cancel_event.is_set():
+            return
+        dialog = Adw.AlertDialog(
+            heading=_("Abort Installation?"),
+            body=_("The running step is stopped right away."),
+        )
+        dialog.add_response("continue", _("_Continue Installing"))
+        dialog.add_response("abort", _("_Abort"))
+        dialog.set_response_appearance("abort", Adw.ResponseAppearance.DESTRUCTIVE)
+        dialog.set_default_response("continue")
+        dialog.set_close_response("continue")
+
+        check = None
+        if self.new_bottle:
+            name = self.entry_name.get_text().strip()
+            check = Gtk.CheckButton(
+                label=_("Delete the bottle “{0}”").format(name),
+                active=True,
+                halign=Gtk.Align.CENTER,
+            )
+            dialog.set_extra_child(check)
+        else:
+            dialog.set_body(
+                _("The running step is stopped right away. Whatever the "
+                  "installer already put into the bottle stays there.")
+            )
+
+        def response(_dialog, response_id):
+            if response_id != "abort":
+                return
+            self.delete_on_abort = bool(check and check.get_active())
+            self.cancel_event.set()
+            self.btn_abort.set_sensitive(False)
+            self.btn_log.set_sensitive(False)
+            self.run_title.set_title(_("Aborting…"))
+            row = self.install_rows.get(self.current) or (
+                self.create_row if self.current < 0 else None
+            )
+            if row:
+                row.show_subtitle(_("Stopping…"))
+
+        dialog.connect("response", response)
+        dialog.present(self)
+
+    def __aborted(self):
+        if self.delete_on_abort and self.new_bottle and self.config is not None:
+            config = self.config
+            try:
+                self.window.page_list.disable_bottle(config)
+            except (KeyError, AttributeError):
+                pass
+            RunAsync(
+                self.manager.delete_bottle,
+                callback=lambda *_: self.window.page_list.update_bottles_list(),
+                config=config,
+            )
+        self.window.show_toast(_("Installation aborted"))
+        self.force_close()
+
+    def __reload_programs(self):
+        """Refresh the bottle's programs however the dialog gets closed."""
+        self.window.page_list.update_bottles_list()
+        details = self.window.page_details
+        shown = getattr(details, "config", None)
+        if shown is not None and shown.get("Name") == self.config.Name:
+            details.view_bottle.update_programs(config=self.config, force_update=True)
+
+    def __show_programs(self, *_args):
+        self.close()
+        if self.new_bottle:
+            self.window.show_details_view(config=self.config)
+        self.window.page_details.view_bottle.update_programs(
+            config=self.config, force_update=True
+        )
+        self.window.page_details.go_back_sidebar()
+
+    # endregion
